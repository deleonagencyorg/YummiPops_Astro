---
import { Image } from 'astro:assets';

interface textHome {
  since: string;
  title: string;
  subtitle: string;
  description: string;
  descrition2: string;
  button: string;
  button2: string;
}

interface Props {
  textHome: textHome;
}

const { textHome } = Astro.props;
---

<div class="home-container bg-white flex items-center">
  <div class="max-w-[1400px] mx-auto w-full flex items-center justify-between px-10 flex flex-col sm:flex-row ">

    <img
      src="https://snack.yummiespromociones.com/SnacksyummiesAssets/banner-pops.webp"
      alt="Yummi Pops"
      class="hidden lg:block w-full"
    />

     <img
      src="https://snack.yummiespromociones.com/SnacksyummiesAssets/banner-pops.webp"
      alt="Yummi Pops"
      class="lg:hidden block w-full"
    />
    
  </div>
</div>
 
<!-- iconos sociales en el home -->
<div class="w-full mt-8 mb-12 md:mb-20 lg:mb-28 flex items-center justify-center">
  <div class="flex gap-6 md:gap-10 items-center">
    <a href="https://www.instagram.com/snacksyummies/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
      <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Ig.svg" alt="Instagram" class="w-8 md:w-10 lg:w-12" />
    </a>

    <a href="https://www.facebook.com/SnacksYummies" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
      <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Facebook.svg" alt="Facebook" class="w-8 md:w-10 lg:w-12" />
    </a>

    <a href="https://www.tiktok.com/@snacksyummies" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
      <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Tik.svg" alt="TikTok" class="w-8 md:w-10 lg:w-12" />
    </a>
  </div>
</div>

<style>
  .home-container {
    height: 850px;
    width: 100%;
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .home-container {
      height: 500px;
    }
  }

  @media (max-width: 767px) {
    .home-container {
      height: 200px;
    }
  }
</style>
