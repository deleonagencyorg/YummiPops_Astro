---
import { Image } from 'astro:assets';

interface textHome {
  since: string;
  title: string;
  subtitle: string;
  description: string;
  descrition2: string;
  button: string;
  button2: string;
}

export interface Banner {
  id?: string;
  href: string;
  desktopImg: string;
  mobileImg: string;
  alt?: string;
}

interface Props {
  textHome: textHome;
  banners?: Banner[];
}

const { textHome, banners: bannersProp } = Astro.props;

// Configuración de banners editable en una variable
const banners: Banner[] = bannersProp || [
  {
    id: 'palomitas',
    href: 'https://yummipops-qa.yummiespromociones.com/es/productos#palomitas',
    desktopImg: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/pops-banner-popcorn.webp',
    mobileImg: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/pops-prueba.webp',
    alt: 'Yummi Pops',
  },
  {
    id: 'nacho',
    href: 'https://yummipops-qa.yummiespromociones.com/es/productos#nacho',
    desktopImg: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/pops-banner-nacho.webp',
    mobileImg: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/pops-banner-nachos-mob-2.webp',
    alt: 'Yummi Pops',
  },
];
---

<div class="home-container bg-white flex items-center">
  <div class="w-full px-0">
    <div class="relative carousel full-bleed overflow-hidden rounded">
      <div class="slides w-full h-full">
        {banners.map((banner) => (
          <a href={banner.href} class="slide block w-full h-full">
            <picture class="w-full h-full block">
              <source media="(min-width:768px)" srcset={banner.desktopImg} />
              <img src={banner.mobileImg} alt={banner.alt || "Yummi Pops"} class="w-full h-full object-cover" />
            </picture>
          </a>
        ))}
      </div>

      <button class="carousel-btn prev absolute left-3 top-1/2 transform -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white w-10 h-10 rounded-full flex items-center justify-center z-20" aria-label="Previous">
        <span class="text-2xl">‹</span>
      </button>
      <button class="carousel-btn next absolute right-3 top-1/2 transform -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white w-10 h-10 rounded-full flex items-center justify-center z-20" aria-label="Next">
        <span class="text-2xl">›</span>
      </button>

      <div class="dots absolute bottom-4 left-1/2 transform -translate-x-1/2 z-20 flex gap-2"></div>
    </div>
  </div>
</div>
 
<!-- iconos sociales en el home -->
<div class="w-full py-4 sm:py-5 md:py-6 lg:py-8 flex items-center justify-center bg-white">
  <div class="flex gap-6 sm:gap-8 md:gap-10 items-center justify-center">
    <a 
      href="https://www.instagram.com/snacksyummies/" 
      target="_blank" 
      rel="noopener noreferrer" 
      aria-label="Instagram"
      class="inline-flex items-center justify-center transition-transform hover:scale-110 opacity-90 hover:opacity-100"
    >
      <img 
        src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Ig.svg" 
        alt="Instagram" 
        class="w-7 h-7 sm:w-8 sm:h-8 md:w-9 md:h-9 lg:w-10 lg:h-10 object-contain" 
      />
    </a>

    <a 
      href="https://www.facebook.com/SnacksYummies" 
      target="_blank" 
      rel="noopener noreferrer" 
      aria-label="Facebook"
      class="inline-flex items-center justify-center transition-transform hover:scale-110 opacity-90 hover:opacity-100"
    >
      <img 
        src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Facebook.svg" 
        alt="Facebook" 
        class="w-7 h-7 sm:w-8 sm:h-8 md:w-9 md:h-9 lg:w-10 lg:h-10 object-contain" 
      />
    </a>

    <a 
      href="https://www.tiktok.com/@snacksyummies" 
      target="_blank" 
      rel="noopener noreferrer" 
      aria-label="TikTok"
      class="inline-flex items-center justify-center transition-transform hover:scale-110 opacity-90 hover:opacity-100"
    >
      <img 
        src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Tik.svg" 
        alt="TikTok" 
        class="w-7 h-7 sm:w-8 sm:h-8 md:w-9 md:h-9 lg:w-10 lg:h-10 object-contain" 
      />
    </a>
  </div>
</div>

<style>
  .home-container {
    width: 100%;
    height: auto;
  }

  .carousel {
    width: 100%;
    aspect-ratio: 430 / 430;
    height: auto;
  }

  .carousel.full-bleed {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  @media (min-width: 768px) {
    .carousel {
      aspect-ratio: 1920 / 1080;
    }
  }

  .slides { position: relative; width: 100%; height: 100%; }
  .slide { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
  .slide picture,
  .slide img { width: 100%; height: 100%; object-fit: cover; }
  .slide.hidden { display: none; }
  .carousel-btn { backdrop-filter: blur(4px); }
  .dots button { width: 10px; height: 10px; border-radius: 9999px; background: rgba(255,255,255,0.5); border: none; }
  .dots button.active { background: #F9A825; }
</style>

<script>
  (function(){
    function init() {
      const container = document.querySelector('.carousel');
      if (!container) return;

      const slides = Array.from(container.querySelectorAll('.slide'));
      const prevBtn = container.querySelector('.carousel-btn.prev');
      const nextBtn = container.querySelector('.carousel-btn.next');
      const dotsContainer = container.querySelector('.dots');
      let current = 0;
      const autoplayDelay = 3000; // ms
      let autoplayId = null;

      if (slides.length === 0) return;

      if (slides.length <= 1) {
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        if (dotsContainer) dotsContainer.style.display = 'none';
        if (slides[0]) slides[0].style.display = 'block';
        return;
      } else {
        if (prevBtn) prevBtn.style.display = 'flex';
        if (nextBtn) nextBtn.style.display = 'flex';
        if (dotsContainer) dotsContainer.style.display = 'flex';
      }

      if (container.__carouselInitialized) return;
      container.__carouselInitialized = true;

      if (dotsContainer) {
        dotsContainer.innerHTML = '';
        slides.forEach((s, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          if (i === 0) btn.classList.add('active');
          btn.addEventListener('click', () => {
            show(i);
            restartAutoplay();
          });
          dotsContainer.appendChild(btn);
        });
      }

      function show(index) {
        current = (index + slides.length) % slides.length;
        slides.forEach((s, i) => {
          s.style.display = i === current ? 'block' : 'none';
        });
        if (dotsContainer) {
          Array.from(dotsContainer.children).forEach((d, i) => d.classList.toggle('active', i === current));
        }
      }

      function startAutoplay() {
        if (autoplayId || slides.length <= 1) return;
        autoplayId = setInterval(() => show(current + 1), autoplayDelay);
      }

      function stopAutoplay() {
        if (!autoplayId) return;
        clearInterval(autoplayId);
        autoplayId = null;
      }

      function restartAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      prevBtn?.addEventListener('click', () => { show(current - 1); restartAutoplay(); });
      nextBtn?.addEventListener('click', () => { show(current + 1); restartAutoplay(); });

      container.addEventListener('mouseenter', stopAutoplay);
      container.addEventListener('mouseleave', startAutoplay);
      container.addEventListener('focusin', stopAutoplay);
      container.addEventListener('focusout', startAutoplay);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay(); else startAutoplay();
      });

      show(0);
      startAutoplay();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
