---
import { Image } from 'astro:assets';

interface textHome {
  since: string;
  title: string;
  subtitle: string;
  description: string;
  descrition2: string;
  button: string;
  button2: string;
}

interface Props {
  textHome: textHome;
}

const { textHome } = Astro.props;
---

<div class="home-container bg-white flex items-center">
  <div class="max-w-[1400px] mx-auto w-full px-0">
    <div class="relative carousel overflow-hidden rounded">
      <div class="slides w-full h-full">
        <!-- Slide 1: Banner 1 -> palomitas -->
        <a href="https://yummipops-qa.yummiespromociones.com/es/productos#palomitas" class="slide block w-full h-full">
          <picture class="w-full h-full block">
            <source media="(min-width:1024px)" srcset="https://snack.yummiespromociones.com/SnacksyummiesAssets/pops-home-1.jpeg" />
            <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/pops-home-1.jpeg" alt="Yummi Pops" class="w-full h-full object-cover" />
          </picture>
        </a>

        <!-- Banner 2 -->
        <a href="https://yummipops-qa.yummiespromociones.com/es/productos#nacho" class="slide block w-full h-full">
          <picture class="w-full h-full block">
            <source media="(min-width:1024px)" srcset="https://snack.yummiespromociones.com/SnacksyummiesAssets/pops-home-2.jpeg" />
            <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/pops-home-2.jpeg" alt="Yummi Pops" class="w-full h-full object-cover" />
          </picture>
        </a>
      </div>

      <button class="carousel-btn prev absolute left-3 top-1/2 transform -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white w-10 h-10 rounded-full flex items-center justify-center z-20" aria-label="Previous">
        <span class="text-2xl">‹</span>
      </button>
      <button class="carousel-btn next absolute right-3 top-1/2 transform -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white w-10 h-10 rounded-full flex items-center justify-center z-20" aria-label="Next">
        <span class="text-2xl">›</span>
      </button>

      <div class="dots absolute bottom-4 left-1/2 transform -translate-x-1/2 z-20 flex gap-2"></div>
    </div>
  </div>
</div>
 
<!-- iconos sociales en el home -->
<div class="w-full mt-8 mb-12 md:mb-20 lg:mb-28 flex items-center justify-center">
  <div class="flex gap-6 md:gap-10 items-center">
    <a href="https://www.instagram.com/snacksyummies/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
      <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Ig.svg" alt="Instagram" class="w-8 md:w-10 lg:w-12" />
    </a>

    <a href="https://www.facebook.com/SnacksYummies" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
      <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Facebook.svg" alt="Facebook" class="w-8 md:w-10 lg:w-12" />
    </a>

    <a href="https://www.tiktok.com/@snacksyummies" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
      <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/Tik.svg" alt="TikTok" class="w-8 md:w-10 lg:w-12" />
    </a>
  </div>
</div>

<style>
  .home-container {
    height: 850px;
    width: 100%;
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .home-container {
      height: 500px;
    }
  }

  @media (max-width: 767px) {
    .home-container {
      height: 200px;
    }
  }

  .carousel { height: 850px; }
  @media (max-width: 767px) { .carousel { height: 200px; } }
  @media (min-width: 768px) and (max-width: 1024px) { .carousel { height: 500px; } }
  .slides { position: relative; width: 100%; height: 100%; }
  .slide { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
  .slide.hidden { display: none; }
  .carousel-btn { backdrop-filter: blur(4px); }
  .dots button { width: 10px; height: 10px; border-radius: 9999px; background: rgba(255,255,255,0.5); border: none; }
  .dots button.active { background: #F9A825; }
</style>

<script>
  (function(){
    function init() {
      const container = document.querySelector('.carousel');
      if (!container) return;
      const slides = Array.from(container.querySelectorAll('.slide'));
      const prevBtn = container.querySelector('.carousel-btn.prev');
      const nextBtn = container.querySelector('.carousel-btn.next');
      const dotsContainer = container.querySelector('.dots');
      let current = 0;
      const autoplayDelay = 3000; // ms
      let autoplayId = null;

      if (slides.length === 0) return;

      slides.forEach((s, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        if (i === 0) btn.classList.add('active');
        btn.addEventListener('click', () => {
          show(i);
          restartAutoplay();
        });
        dotsContainer.appendChild(btn);
      });

      function show(index) {
        current = (index + slides.length) % slides.length;
        slides.forEach((s, i) => {
          s.style.display = i === current ? 'block' : 'none';
        });
        Array.from(dotsContainer.children).forEach((d, i) => d.classList.toggle('active', i === current));
      }

      function startAutoplay() {
        if (autoplayId || slides.length <= 1) return;
        autoplayId = setInterval(() => show(current + 1), autoplayDelay);
      }

      function stopAutoplay() {
        if (!autoplayId) return;
        clearInterval(autoplayId);
        autoplayId = null;
      }

      function restartAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      prevBtn?.addEventListener('click', () => { show(current - 1); restartAutoplay(); });
      nextBtn?.addEventListener('click', () => { show(current + 1); restartAutoplay(); });

      container.addEventListener('mouseenter', stopAutoplay);
      container.addEventListener('mouseleave', startAutoplay);
      container.addEventListener('focusin', stopAutoplay);
      container.addEventListener('focusout', startAutoplay);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay(); else startAutoplay();
      });

      show(0);
      startAutoplay();

      document.addEventListener('astro:page-load', () => setTimeout(() => { show(current); restartAutoplay(); }, 100));
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
