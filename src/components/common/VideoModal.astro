<!-- Modal de video -->
<div id="video-modal" data-mode="default" class="video-modal-overlay fixed inset-0 z-[2147483648] isolate hidden items-center justify-center bg-black/80 backdrop-blur-sm" aria-hidden="true">
  <div id="video-modal-content" data-mode="default" class="video-modal-container relative w-full max-w-4xl mx-4 aspect-video bg-black rounded-xl overflow-hidden shadow-2xl flex items-center justify-center">
    <!-- Botón cerrar -->
    <button
      id="video-modal-close"
      type="button"
      class="video-modal-close absolute top-3 right-3 z-10 text-white bg-black/50 hover:bg-black/70 rounded-full p-2 transition-colors"
      aria-label="Cerrar video"
    >
      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Iframe de YouTube -->
    <iframe
      id="video-modal-iframe"
      class="video-modal-iframe w-full h-full hidden"
      src=""
      title="YouTube video player"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>

    <!-- Reproductor nativo -->
    <video
      id="video-modal-player"
      class="video-modal-player w-full h-full object-cover hidden"
      controls
      playsinline
      preload="auto"
    ></video>
  </div>
</div>

<style is:inline>
  .video-modal-iframe {
    border: none;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .video-modal-player {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #video-modal-content[data-mode='direct-portrait'],
  #video-modal-content[data-mode='direct-portrait-mobile'],
  #video-modal-content[data-mode='shorts-desktop'],
  #video-modal-content[data-mode='shorts-mobile'] {
    width: auto;
    height: 85dvh;
    max-height: 85dvh;
    aspect-ratio: 9 / 16;
    max-width: min(90vw, calc(85dvh * 9 / 16));
    border-radius: 1rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  #video-modal-content[data-mode='direct-landscape'],
  #video-modal-content[data-mode='direct-landscape-mobile'] {
    width: min(90vw, calc(85dvh * 16 / 9));
    height: auto;
    max-height: 85dvh;
    aspect-ratio: 16 / 9;
    border-radius: 1rem;
  }

  @media (max-width: 767px) {
    .video-modal-close {
      top: calc(0.5rem + env(safe-area-inset-top, 0px));
      right: calc(0.5rem + env(safe-area-inset-right, 0px));
    }
  }
</style>

<script is:inline>
  function isYouTube(url) {
    if (!url) return false;
    return /youtu\.be|youtube\.com/.test(url);
  }

  function extractYouTubeId(url) {
    if (!url) return '';
    var regExp = /^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|shorts\/|\&v=)([^#\&\?]*).*/;
    var match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : '';
  }

  function isYouTubeShort(url) {
    if (!url) return false;
    return /youtube\.com\/shorts\//.test(url);
  }

  function isMobileViewport() {
    return window.matchMedia('(max-width: 767px)').matches;
  }

  function buildEmbedUrl(videoId) {
    var params = new URLSearchParams({
      autoplay: '1',
      controls: '1',
      playsinline: '1',
      rel: '0',
      modestbranding: '1'
    });
    return 'https://www.youtube.com/embed/' + videoId + '?' + params.toString();
  }

  function setDisplayMode(container, modal, mode) {
    if (modal) modal.dataset.mode = mode;
    if (container) container.dataset.mode = mode;
    if (container) container.style.removeProperty('aspect-ratio');
  }

  window.__openVideoModal = function (videoUrl) {
    if (!videoUrl) return;
    var modal = document.getElementById('video-modal');
    var container = document.getElementById('video-modal-content');
    var iframe = document.getElementById('video-modal-iframe');
    var videoPlayer = document.getElementById('video-modal-player');
    if (!modal || !container) return;

    var isMobile = isMobileViewport();

    if (isYouTube(videoUrl)) {
      var videoId = extractYouTubeId(videoUrl);
      if (!videoId) return;

      if (videoPlayer) {
        videoPlayer.pause();
        videoPlayer.removeAttribute('src');
        videoPlayer.load();
        videoPlayer.classList.add('hidden');
      }

      if (iframe) {
        var isShort = isYouTubeShort(videoUrl);
        var displayMode = isShort ? (isMobile ? 'shorts-mobile' : 'shorts-desktop') : 'default';
        setDisplayMode(container, modal, displayMode);
        iframe.src = buildEmbedUrl(videoId);
        iframe.classList.remove('hidden');
      }
    } else {
      if (iframe) {
        iframe.src = '';
        iframe.classList.add('hidden');
      }

      var defaultMode = isMobile ? 'direct-portrait-mobile' : 'direct-portrait';
      setDisplayMode(container, modal, defaultMode);

      if (videoPlayer) {
        videoPlayer.src = videoUrl;
        videoPlayer.classList.remove('hidden');

        videoPlayer.onloadedmetadata = function() {
          var vw = videoPlayer.videoWidth;
          var vh = videoPlayer.videoHeight;
          if (vw && vh) {
            var isPortrait = vh > vw;
            if (isPortrait) {
              var mode = isMobile ? 'direct-portrait-mobile' : 'direct-portrait';
              setDisplayMode(container, modal, mode);
            } else {
              var mode = isMobile ? 'direct-landscape-mobile' : 'direct-landscape';
              setDisplayMode(container, modal, mode);
            }
          }
        };

        videoPlayer.load();
        var playPromise = videoPlayer.play();
        if (playPromise !== undefined) {
          playPromise.catch(function(err) {
            console.warn('Autoplay unmuted blocked, falling back to muted autoplay:', err);
            videoPlayer.muted = true;
            videoPlayer.play();
          });
        }
      }
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    try {
      var scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      document.body.style.position = 'fixed';
      document.body.style.top = '-' + scrollY + 'px';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.dataset.__scrollY = scrollY;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    } catch (e) {
      document.body.style.overflow = 'hidden';
    }
  };

  window.openVideoModal = window.__openVideoModal;

  window.__closeVideoModal = function () {
    var modal = document.getElementById('video-modal');
    var container = document.getElementById('video-modal-content');
    var iframe = document.getElementById('video-modal-iframe');
    var videoPlayer = document.getElementById('video-modal-player');
    if (!modal || !container) return;

    if (iframe) {
      iframe.src = '';
      iframe.classList.add('hidden');
    }

    if (videoPlayer) {
      videoPlayer.pause();
      videoPlayer.removeAttribute('src');
      videoPlayer.load();
      videoPlayer.classList.add('hidden');
    }

    setDisplayMode(container, modal, 'default');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    try {
      var prevScrollY = parseInt(document.body.dataset.__scrollY || '0', 10) || 0;
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      delete document.body.dataset.__scrollY;
      window.scrollTo(0, prevScrollY);
    } catch (e) {
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
    }
  };

  window.closeVideoModal = window.__closeVideoModal;

  function initVideoModal() {
    var modal = document.getElementById('video-modal');
    var closeBtn = document.getElementById('video-modal-close');
    if (!modal || !closeBtn) return;
    try {
      if (modal.parentNode !== document.body) {
        document.body.appendChild(modal);
      }
    } catch (e) {}

    var newCloseBtn = closeBtn.cloneNode(true);
    closeBtn.parentNode.replaceChild(newCloseBtn, closeBtn);

    var newModal = modal;
    if (!newModal._videoModalBound) {
      newModal._videoModalBound = true;
      newModal.addEventListener('click', function (e) {
        if (e.target === newModal) window.__closeVideoModal();
      });
    }

    newCloseBtn.addEventListener('click', window.__closeVideoModal);
  }

  if (!window.__videoClickDelegated) {
    window.__videoClickDelegated = true;
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-video]');
      if (trigger) {
        e.preventDefault();
        e.stopPropagation();
        var videoUrl = trigger.getAttribute('data-video');
        if (videoUrl) window.__openVideoModal(videoUrl);
      }
    }, true);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        var modal = document.getElementById('video-modal');
        if (modal && !modal.classList.contains('hidden')) {
          window.__closeVideoModal();
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initVideoModal);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoModal);
  } else {
    initVideoModal();
  }
</script>
