<!-- Modal de video -->
<div id="video-modal" class="fixed inset-0 z-[2147483648] isolate hidden items-center justify-center bg-black/90" aria-hidden="true">
  <div id="video-modal-content" class="relative w-full max-w-4xl mx-4 aspect-video bg-black rounded-2xl overflow-hidden shadow-2xl flex items-center justify-center">
    <!-- Botón cerrar -->
    <button
      id="video-modal-close"
      type="button"
      class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/20 hover:bg-white/40 flex items-center justify-center transition-colors"
      aria-label="Cerrar video"
    >
      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Iframe de YouTube -->
    <iframe
      id="video-modal-iframe"
      class="w-full h-full hidden"
      src=""
      title="YouTube video player"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>

    <!-- Reproductor nativo -->
    <video
      id="video-modal-player"
      class="w-full h-full object-contain hidden"
      controls
      playsinline
      preload="metadata"
    ></video>
  </div>
</div>

<style is:inline>
  #video-modal.video-fullscreen {
    align-items: stretch;
    justify-content: center;
    background: black;
  }

  #video-modal.video-fullscreen #video-modal-content {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
    overflow: hidden;
    background: black;
  }

  #video-modal.video-fullscreen #video-modal-iframe,
  #video-modal.video-fullscreen #video-modal-player {
    width: 100%;
    height: 100%;
    border: none;
  }

  #video-modal.video-fullscreen #video-modal-close {
    position: fixed;
    top: 12px;
    right: 12px;
    z-index: 10010;
  }

  #video-modal.direct-video #video-modal-content {
    max-height: 85vh;
    aspect-ratio: auto;
    height: 80vh;
  }
</style>

<script is:inline>
  function isYouTube(url) {
    if (!url) return false;
    return /youtu\.be|youtube\.com/.test(url);
  }

  // ─── Helpers
  window.__videoToEmbedUrl = function (url) {
    if (!url) return '';
    var shortsMatch = url.match(/youtube\.com\/shorts\/([a-zA-Z0-9_-]+)/);
    if (shortsMatch) return 'https://www.youtube.com/embed/' + shortsMatch[1];
    var watchMatch = url.match(/[?&]v=([a-zA-Z0-9_-]+)/);
    if (watchMatch) return 'https://www.youtube.com/embed/' + watchMatch[1];
    var beMatch = url.match(/youtu\.be\/([a-zA-Z0-9_-]+)/);
    if (beMatch) return 'https://www.youtube.com/embed/' + beMatch[1];
    var embedMatch = url.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]+)/);
    if (embedMatch) return url;
    return '';
  };

  window.__openVideoModal = function (videoUrl) {
    if (!videoUrl) return;
    var modal = document.getElementById('video-modal');
    var iframe = document.getElementById('video-modal-iframe');
    var videoPlayer = document.getElementById('video-modal-player');
    if (!modal) return;

    var isMobile = (typeof navigator !== 'undefined' && /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) || (window.matchMedia && window.matchMedia('(max-width: 768px)').matches);

    if (isYouTube(videoUrl)) {
      var embedUrl = window.__videoToEmbedUrl(videoUrl);
      if (!embedUrl) return;

      if (videoPlayer) {
        videoPlayer.pause();
        videoPlayer.src = '';
        videoPlayer.removeAttribute('src');
        videoPlayer.load();
        videoPlayer.classList.add('hidden');
      }

      var isShorts = /shorts/i.test(videoUrl);
      var params = '?autoplay=1&rel=0&playsinline=1';

      if (iframe) {
        iframe.src = embedUrl + params;
        iframe.classList.remove('hidden');
      }

      var lang = '';
      try {
        lang = (document.documentElement && document.documentElement.lang) || ((location.pathname.match(/^\/(es|en)(\/|$)/) || [])[1]) || '';
      } catch (e) {
        lang = '';
      }
      lang = (lang || '').toLowerCase();
      var allowedLangs = ['es', 'en'];
      var isAllowedLang = allowedLangs.indexOf(lang) !== -1;

      if (isShorts && isMobile && isAllowedLang) {
        modal.classList.add('video-fullscreen');
        modal.classList.remove('direct-video');
      } else {
        modal.classList.remove('video-fullscreen');
        modal.classList.remove('direct-video');
      }
    } else {
      if (iframe) {
        iframe.src = '';
        iframe.classList.add('hidden');
      }

      if (isMobile) {
        modal.classList.add('video-fullscreen');
        modal.classList.remove('direct-video');
      } else {
        modal.classList.add('direct-video');
        modal.classList.remove('video-fullscreen');
      }

      if (videoPlayer) {
        videoPlayer.src = videoUrl;
        videoPlayer.classList.remove('hidden');
        videoPlayer.play().catch(function (err) {
          console.warn('Autoplay prevented by browser:', err);
        });
      }
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    try {
      var scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      document.body.style.position = 'fixed';
      document.body.style.top = '-' + scrollY + 'px';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.dataset.__scrollY = scrollY;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    } catch (e) {
      document.body.style.overflow = 'hidden';
    }
  };

  window.openVideoModal = window.__openVideoModal;

  window.__closeVideoModal = function () {
    var modal = document.getElementById('video-modal');
    var iframe = document.getElementById('video-modal-iframe');
    var videoPlayer = document.getElementById('video-modal-player');
    if (!modal) return;

    if (iframe) {
      iframe.src = '';
      iframe.classList.add('hidden');
    }

    if (videoPlayer) {
      videoPlayer.pause();
      videoPlayer.src = '';
      videoPlayer.removeAttribute('src');
      videoPlayer.load();
      videoPlayer.classList.add('hidden');
    }

    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.classList.remove('video-fullscreen');
    modal.classList.remove('direct-video');
    modal.setAttribute('aria-hidden', 'true');
    try {
      var prevScrollY = parseInt(document.body.dataset.__scrollY || '0', 10) || 0;
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      delete document.body.dataset.__scrollY;
      window.scrollTo(0, prevScrollY);
    } catch (e) {
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
    }
  };

  window.closeVideoModal = window.__closeVideoModal;

  function initVideoModal() {
    var modal = document.getElementById('video-modal');
    var iframe = document.getElementById('video-modal-iframe');
    var closeBtn = document.getElementById('video-modal-close');
    if (!modal || !closeBtn) return;
    try {
      if (modal.parentNode !== document.body) {
        document.body.appendChild(modal);
      }
    } catch (e) {
    }

    var newCloseBtn = closeBtn.cloneNode(true);
    closeBtn.parentNode.replaceChild(newCloseBtn, closeBtn);

    var newModal = modal;
    if (!newModal._videoModalBound) {
      newModal._videoModalBound = true;
      newModal.addEventListener('click', function (e) {
        if (e.target === newModal) window.__closeVideoModal();
      });
    }

    newCloseBtn.addEventListener('click', window.__closeVideoModal);
  }

  if (!window.__videoClickDelegated) {
    window.__videoClickDelegated = true;
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-video]');
      if (trigger) {
        e.preventDefault();
        e.stopPropagation();
        var videoUrl = trigger.getAttribute('data-video');
        if (videoUrl) window.__openVideoModal(videoUrl);
      }
    }, true);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        var modal = document.getElementById('video-modal');
        if (modal && !modal.classList.contains('hidden')) {
          window.__closeVideoModal();
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initVideoModal);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoModal);
  } else {
    initVideoModal();
  }
</script>
