(function () {
  var COUNTRY_PLACEHOLDER = 'Selecciona tu país';
  var CITY_PLACEHOLDER    = 'Selecciona tu ciudad';

  function cfBuildPanel(panelEl, items) {
    panelEl.innerHTML = '';
    items.forEach(function (item) {
      var li  = document.createElement('li');
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', 'false');
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cf-dropdown-option';
      btn.setAttribute('data-value',   item.value);
      btn.setAttribute('data-display', item.display);
      btn.textContent = item.display;
      li.appendChild(btn);
      panelEl.appendChild(li);
    });
  }

  function cfOpen(id) {
    var panel = document.getElementById(id + '_panel');
    var btn   = document.getElementById(id + '_btn');
    var arrow = document.getElementById(id + '_arrow');
    if (!panel || !btn) return;
    panel.classList.remove('hidden');
    if (arrow) arrow.style.transform = 'rotate(180deg)';
    btn.setAttribute('aria-expanded', 'true');
    btn.classList.add('cf-dropdown-btn--active');
  }
  function cfClose(id) {
    var panel = document.getElementById(id + '_panel');
    var btn   = document.getElementById(id + '_btn');
    var arrow = document.getElementById(id + '_arrow');
    if (!panel) return;
    panel.classList.add('hidden');
    if (arrow) arrow.style.transform = '';
    if (btn)  { btn.setAttribute('aria-expanded', 'false'); btn.classList.remove('cf-dropdown-btn--active'); }
  }
  function cfCloseAll() { ['cfCR','cfCountry','cfCity'].forEach(cfClose); }

 
  function cfMarkSelected(id, value) {
    var panel = document.getElementById(id + '_panel');
    if (!panel) return;
    panel.querySelectorAll('.cf-dropdown-option').forEach(function (o) {
      var sel = o.getAttribute('data-value') === value;
      o.classList.toggle('cf-dropdown-option--sel', sel);
      o.closest('li').setAttribute('aria-selected', String(sel));
    });
  }
  function cfSetLabel(id, text, isPlaceholder) {
    var lbl = document.getElementById(id + '_label');
    var btn = document.getElementById(id + '_btn');
    if (lbl) lbl.textContent = text;
    if (btn) btn.classList.toggle('cf-dropdown-btn--placeholder', !!isPlaceholder);
  }
  function cfResetDropdown(id, placeholder) {
    cfSetLabel(id, placeholder, true);
    cfMarkSelected(id, '');
    cfClose(id);
  }

  /* ---- main init (called on every navigation) ------------------ */
  function _cfInit() {

    /* === 1. CONTACT REASON ==================================== */
    (function () {
      var btn    = document.getElementById('cfCR_btn');
      var panel  = document.getElementById('cfCR_panel');
      var hidden = document.getElementById('contactReasonSelect');
      if (!btn || !panel) return;

      /* cloneNode removes ALL accumulated listeners on the VISIBLE elements */
      var fb = btn.cloneNode(true);   btn.parentNode.replaceChild(fb, btn);
      var fp = panel.cloneNode(true); panel.parentNode.replaceChild(fp, panel);

      if (hidden && hidden.options.length > 1) {
        cfBuildPanel(fp, Array.from(hidden.options)
          .filter(function (o) { return !!o.value; })
          .map(function (o) { return { value: o.value, display: o.text }; })
        );
      }

      fb.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = !fp.classList.contains('hidden');
        cfCloseAll();
        if (!open) cfOpen('cfCR');
      });

      fp.addEventListener('click', function (e) {
        var opt = e.target.closest('.cf-dropdown-option');
        if (!opt) {
          var li = e.target.closest('li[role="option"]');
          if (li) opt = li.querySelector('.cf-dropdown-option');
        }
        if (!opt) return;
        var value   = opt.getAttribute('data-value');
        var display = opt.getAttribute('data-display') || value;

        cfSetLabel('cfCR', display, false);
        cfMarkSelected('cfCR', value);
        cfClose('cfCR');

        /* Sync hidden native select.
           initFormFunctionality set .onchange on it → fires via dispatchEvent (synchronous).
           That .onchange enables countrySelect.disabled = false and calls updateDynamicFields. */
        if (hidden) {
          hidden.value = value;
          hidden.dispatchEvent(new Event('change'));
        }

        /* Also update the VISIBLE country button */
        var cbtn = document.getElementById('cfCountry_btn');
        if (cbtn) cbtn.disabled = !value;

        /* Reset country & city custom dropdowns */
        cfResetDropdown('cfCountry', COUNTRY_PLACEHOLDER);
        cfResetDropdown('cfCity',    CITY_PLACEHOLDER);
        var cityBtn = document.getElementById('cfCity_btn');
        if (cityBtn) cityBtn.disabled = true;
        var cityPanel = document.getElementById('cfCity_panel');
        if (cityPanel) cityPanel.innerHTML = '';
        var countryHid = document.getElementById('countrySelect');
        if (countryHid) countryHid.value = '';
        var cityHid = document.getElementById('departmentSelect');
        if (cityHid) { cityHid.value = ''; cityHid.innerHTML = ''; }
      });
    }());

    /* === 2. COUNTRY =========================================== */
    (function () {
      var btn    = document.getElementById('cfCountry_btn');
      var panel  = document.getElementById('cfCountry_panel');
      var hidden = document.getElementById('countrySelect');
      if (!btn || !panel) return;

      var fb = btn.cloneNode(true);   btn.parentNode.replaceChild(fb, btn);
      var fp = panel.cloneNode(true); panel.parentNode.replaceChild(fp, panel);

      /* Build panel from the native select (initFormFunctionality already filled it) */
      if (hidden && hidden.options.length > 1) {
        cfBuildPanel(fp, Array.from(hidden.options)
          .filter(function (o) { return !!o.value; })
          .map(function (o) { return { value: o.value, display: o.text }; })
        );
      }

      fb.addEventListener('click', function (e) {
        e.stopPropagation();
        if (fb.disabled) return;
        var open = !fp.classList.contains('hidden');
        cfCloseAll();
        if (!open) cfOpen('cfCountry');
      });

      fp.addEventListener('click', function (e) {
        var opt = e.target.closest('.cf-dropdown-option');
        if (!opt) {
          var li = e.target.closest('li[role="option"]');
          if (li) opt = li.querySelector('.cf-dropdown-option');
        }
        if (!opt) return;
        var value   = opt.getAttribute('data-value');
        var display = opt.getAttribute('data-display') || value;

        cfSetLabel('cfCountry', display, false);
        cfMarkSelected('cfCountry', value);
        cfClose('cfCountry');

        /* Sync hidden native countrySelect.
           initFormFunctionality's .onchange fires synchronously:
           it clears departmentSelect and adds city <option>s. */
        if (hidden) {
          hidden.value = value;
          hidden.dispatchEvent(new Event('change'));
        }

        /* Now departmentSelect has city options — build city panel */
        var cityHid   = document.getElementById('departmentSelect');
        var cityPanel = document.getElementById('cfCity_panel');
        var cityBtn   = document.getElementById('cfCity_btn');

        cfResetDropdown('cfCity', CITY_PLACEHOLDER);
        if (cityHid)   cityHid.value = '';

        if (cityPanel && cityHid && cityHid.options.length > 1) {
          cfBuildPanel(cityPanel, Array.from(cityHid.options)
            .filter(function (o) { return !!o.value; })
            .map(function (o) { return { value: o.value, display: o.text }; })
          );
          if (cityBtn) cityBtn.disabled = false;
        } else {
          if (cityBtn) cityBtn.disabled = true;
        }
      });
    }());

    /* === 3. CITY ============================================== */
    (function () {
      var btn    = document.getElementById('cfCity_btn');
      var panel  = document.getElementById('cfCity_panel');
      var hidden = document.getElementById('departmentSelect');
      if (!btn || !panel) return;

      var fb = btn.cloneNode(true);   btn.parentNode.replaceChild(fb, btn);
      var fp = panel.cloneNode(true); panel.parentNode.replaceChild(fp, panel);

      fb.addEventListener('click', function (e) {
        e.stopPropagation();
        if (fb.disabled) return;
        var open = !fp.classList.contains('hidden');
        cfCloseAll();
        if (!open) cfOpen('cfCity');
      });

      fp.addEventListener('click', function (e) {
        var opt = e.target.closest('.cf-dropdown-option');
        if (!opt) {
          var li = e.target.closest('li[role="option"]');
          if (li) opt = li.querySelector('.cf-dropdown-option');
        }
        if (!opt) return;
        var value   = opt.getAttribute('data-value');
        var display = opt.getAttribute('data-display') || value;

        cfSetLabel('cfCity', display, false);
        cfMarkSelected('cfCity', value);
        cfClose('cfCity');

        if (hidden) {
          hidden.value = value;
          hidden.dispatchEvent(new Event('change'));
        }
      });
    }());
  }

  /* ---- outside-click to close (registered ONCE) --------------- */
  if (!window._cfDocListenerSet) {
    window._cfDocListenerSet = true;
    document.addEventListener('click', function (e) {
      var inside = ['cfCR_wrapper','cfCountry_wrapper','cfCity_wrapper'].some(function (id) {
        var w = document.getElementById(id);
        return w && w.contains(e.target);
      });
      if (!inside) cfCloseAll();
    });
  }

  /* ---- navigation guards -------------------------------------- */
  if (!window._cfInitListenersSet) {
    window._cfInitListenersSet = true;
    document.addEventListener('astro:page-load',  _cfInit);
    document.addEventListener('astro:after-swap', _cfInit);
  }
  if (document.readyState !== 'loading') _cfInit();
  else document.addEventListener('DOMContentLoaded', _cfInit);
}());
</script>
