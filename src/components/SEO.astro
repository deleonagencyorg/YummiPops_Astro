---
import { t, type Locale } from '../i18n/i18n';
import config from '../i18n/config';

export interface SEOData {
  metaTitle?: string;
  metaDescription?: string;
  metaKeywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string | { url: string };
  canonicalUrl?: string;
}

export interface Props {
  currentLang: Locale;
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  imageUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string | { url: string };
  seoData?: SEOData;
}

const {
  currentLang,
  title,
  description,
  keywords,
  canonicalUrl,
  imageUrl,
  ogTitle,
  ogDescription,
  ogImage,
  seoData
} = Astro.props;

// Obtener traducciones por defecto
const meta = (t('meta', { namespace: 'common', locale: currentLang }) as any) || {};
const socialMedia = (t('social_media', { namespace: 'common', locale: currentLang }) as any) || {};

// Extraer imagen si viene como objeto { url: string }
const resolveImageUrl = (img?: string | { url: string }): string => {
  if (!img) return '';
  if (typeof img === 'string') return img;
  if (typeof img === 'object' && img.url) return img.url;
  return '';
};

const defaultTitle = currentLang === 'es' ? 'Yummi Pops - Deliciosos Snacks' : 'Yummi Pops - Delicious Snacks';
const defaultDescription = currentLang === 'es' ? 'Descubre los deliciosos snacks Yummi Pops' : 'Discover delicious Yummi Pops snacks';
const defaultImage = 'https://snack.yummiespromociones.com/SnacksyummiesAssets/logo-pops2.webp';
const defaultKeywords = currentLang === 'es'
  ? 'yummi pops, palomitas, nacho, snacks centroamérica, snacks yummies'
  : 'yummi pops, popcorn, nacho, central america snacks, snacks yummies';

// Prioridad: props directos > seoData del CMS > traducciones locales por defecto
const pageTitle = title || seoData?.metaTitle || meta?.home?.title || defaultTitle;
const pageDescription = description || seoData?.metaDescription || meta?.home?.description || defaultDescription;
const pageKeywords = keywords || seoData?.metaKeywords || defaultKeywords;

const finalOgTitle = ogTitle || seoData?.ogTitle || pageTitle;
const finalOgDescription = ogDescription || seoData?.ogDescription || pageDescription;
const rawOgImage = ogImage || seoData?.ogImage || imageUrl;
const pageImage = resolveImageUrl(rawOgImage) || defaultImage;

const pageUrl = canonicalUrl || seoData?.canonicalUrl || `https://yummipops.com/${currentLang}`;

// URLs Redes Sociales
const facebookUrl = socialMedia?.facebook?.url || '';
const instagramUrl = socialMedia?.instagram?.url || '';
const twitterUrl = socialMedia?.twitter?.url || '';
---

<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
{pageKeywords && <meta name="keywords" content={pageKeywords} />}
<meta name="robots" content="index, follow" />
<link rel="canonical" href={pageUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={finalOgTitle} />
<meta property="og:description" content={finalOgDescription} />
<meta property="og:image" content={pageImage} />
<meta property="og:locale" content={currentLang === 'es' ? 'es_ES' : 'en_US'} />
{config.supportedLocales.map((lang) => (
  <meta property="og:locale:alternate" content={lang === 'es' ? 'es_ES' : 'en_US'} />
))}

<!-- Image Optimization -->
<meta name="og:image:width" content="1200" />
<meta name="og:image:height" content="630" />
<meta name="og:image:alt" content={pageTitle} />

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={pageUrl} />
<meta name="twitter:title" content={finalOgTitle} />
<meta name="twitter:description" content={finalOgDescription} />
<meta name="twitter:image" content={pageImage} />

<!-- Social Media Links -->
{facebookUrl && <link rel="me" href={facebookUrl} />}
{instagramUrl && <link rel="me" href={instagramUrl} />}
{twitterUrl && <link rel="me" href={twitterUrl} />}

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Yummi Pops",
  "url": "https://yummipops.com",
  "logo": "https://snack.yummiespromociones.com/SnacksyummiesAssets/logo-pops2.webp",
  "sameAs": [
    socialMedia.facebook?.url,
    socialMedia.instagram?.url,
    socialMedia.tiktok?.url
  ].filter(Boolean)
})}></script>

<!-- Breadcrumbs Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": currentLang === 'es' ? 'Inicio' : 'Home',
      "item": `https://yummipops.com/${currentLang}`
    }
  ]
})}></script>

<!-- Theme Color -->
<meta name="theme-color" content="#0A3D7E" />
<meta name="msapplication-TileColor" content="#0A3D7E" />
