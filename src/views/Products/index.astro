---
// src/components/pages/ProductsPage.astro
import LazyImage from '../../components/common/LazyImage.astro';
import { t } from '../../i18n/i18n';
import type { Locale } from '../../i18n/i18n';
import { getLocale } from '../../i18n/i18n';

const currentLang = getLocale();
const products = t('items', { namespace: 'products', locale: currentLang }) || [];
const productsImages = [
  { image: '/images/es/products/product3-pops.png', name: "Yummi Pops Palomitas" },
  { image: '/images/es/products/product1-pops.png', name: "Yummi Pops Palomitas" }
];


// Textos
const heroTitle = currentLang === 'es' ? 'Descubre nuestros sabores' : 'Discover our flavors';
const heroSubtitle = currentLang === 'es' ? 'Cada snack para cada momento inolvidable.' : 'Every snack for every unforgettable moment.';
const heroButton = currentLang === 'es' ? 'Explorar ahora' : 'Explore now';
const sectionTitle = currentLang === 'es' ? 'Todos los productos' : 'All products';

// Categorías/filtros
const categories = [
  { label: currentLang === 'es' ? 'Todos' : 'All', value: 'all' },
  { label: 'Yummi Pops Nacho', value: 'nacho' },
  { label: 'Yummi Pops Palomitas', value: 'palomitas' }
];

// Features del hero
const features = [
  {
    icon: '/images/es/grasa.png'
  },
  {
    icon: '/images/es/gluten.png'
  },
  {
    icon: '/images/es/maiz.png'
  }
];
---

<!-- Hero Section -->
<section class="hidden xl:block relative bg-[#2392D3] to-blue-500 rounded-[30px] md:rounded-[40px] mx-4 md:mx-8 mt-8 mb-12 overflow-hidden">
  <div class="container mx-auto px-6 md:px-12 py-12 md:py-16 lg:py-20">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 items-center">
      <div class="nacho-pattern" style="background-image: url('/images/es/bg-product.png');"></div>
      <!-- Lado Izquierdo - Contenido -->
      <div class="text-white space-y-6 z-10 relative pl-[20px]">
        <div class="hidden xl:block">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight">
          {heroTitle}
          </h1>
          <p class="text-lg md:text-xl mb-8">
            {heroSubtitle}
          </p>
          
          <button class="bg-white text-black font-bold px-8 py-3 rounded-full hover:bg-gray-100 transition-all transform hover:scale-105 shadow-lg">
            {heroButton}
          </button>
        </div>

        <!-- Features -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 pt-2">
          {features.map((feature) => (
            <div class="text-center">
              <LazyImage
                src={feature.icon}
                alt="Feature Icon"
                class="w-[163px] h-[63px] object-contain mx-auto mb-2"
              />
            </div>
          ))}
        </div>
      </div>

      <!-- Lado Derecho - Imágenes de Productos -->
      <div class="hidden lg:hidden xl:block relative h-[300px] md:h-[400px] lg:h-[500px]">
        {productsImages.slice(0, 2).map((product: any, index: number) => (
          <img
            src={product.image || '/images/products/placeholder.jpg'}
            alt={product.name}
            class={`absolute w-64 h-auto object-contain drop-shadow-2xl ${
              index === 0 
                ? 'top-0 left-[10px] z-20 transform w-[390px] h-[300px]' 
                : 'top-[60px] right-0 z-10 transform rotate-[50deg] w-[350px] h-[300px]'
            }`}
          />
        ))}
      </div>

      <div class="hidden lg:block xl:hidden relative h-[300px] md:h-[400px] lg:h-[500px]">
        {productsImages.slice(0, 2).map((product: any, index: number) => (
          <img
            src={product.image || '/images/products/placeholder.jpg'}
            alt={product.name}
            class={`absolute w-64 h-auto object-contain drop-shadow-2xl ${
              index === 0 
                ? 'top-[120px] left-[250px] z-20 transform w-[250px] h-[250px]' 
                : 'top-[120px] right-[150px] z-10 transform rotate-[30deg] w-[250px] h-[250px]'
            }`}
          />
        ))}
      </div>

      <div class="block sm:hidden lg:hidden xl:hidden relative items-center h-[300px] md:h-[400px] lg:h-[500px]">
        {productsImages.slice(0, 1).map((product: any, index: number) => (
          <img
            src={product.image || '/images/products/placeholder.jpg'}
            alt={product.name}
            class={`absolute w-64 h-auto object-contain drop-shadow-2xl ${
              index === 0 
                ? 'top-[0px] left-[50px] z-20 transform w-[250px] h-[240px]' 
                : 'top-[50px] right-[50px] z-10 transform rotate-[30deg] w-[250px] h-[250px]'
            }`}
          />
        ))}
      </div>

      <div class="hidden sm:block lg:hidden xl:hidden relative items-center h-[300px] md:h-[400px] lg:h-[500px]">
        {productsImages.slice(0, 1).map((product: any, index: number) => (
          <img
            src={product.image || '/images/products/placeholder.jpg'}
            alt={product.name}
            class={`absolute w-64 h-auto object-contain drop-shadow-2xl ${
              index === 0 
                ? 'top-[0px] left-[200px] z-20 transform w-[250px] h-[250px]' 
                : 'top-[50px] right-[50px] z-10 transform rotate-[30deg] w-[250px] h-[250px]'
            }`}
          />
        ))}
      </div>

      <div class="block xl:hidden text-white md:p-0 p-12">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight">
          {heroTitle}
          </h1>
          <p class="text-lg md:text-xl mb-8">
            {heroSubtitle}
          </p>
          
          <button class="bg-white text-black font-bold px-8 py-3 rounded-full hover:bg-gray-100 transition-all transform hover:scale-105 shadow-lg">
            {heroButton}
          </button>
        </div>
    </div>
  </div>
</section>

<section class="hidden md:hidden lg:block xl:hidden relative bg-[#2392D3] rounded-[30px]  mx-4 mt-8 mb-12 ">
  <div class="container mx-auto px-6 md:px-12 py-12 md:py-16 lg:py-20">
