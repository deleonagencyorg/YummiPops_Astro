<!-- Products Section -->
<div class="bg-white py-12">
  <div class="container mx-auto px-4">
    
    <!-- Header -->
    <div class="mb-8">
      <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-6">
        {sectionTitle}
      </h2>
        <div class="hidden xl:block absolute bottom-0 top-[620px] right-[660px] pointer-events-none z-20">
          <img src="/images/es/pop1.png" alt="Decorative Pattern" class="w-[120px] h-[159px] object-cover" />
        </div>

        <div class="hidden xl:block absolute bottom-0 top-[200px] right-[900px] pointer-events-none z-20 rotate-[50deg]">
          <img src="/images/es/pop1.png" alt="Decorative Pattern" class="w-[150px] h-[150px] object-cover" />
        </div>

         <div class="hidden md:block lg:hidden xl:hidden absolute bottom-0 top-[550px] right-[490px] pointer-events-none z-20">
          <img src="/images/es/pop1.png" alt="Decorative Pattern" class="w-[120px] h-[159px] object-cover" />
        </div>

        <div class="hidden md:block lg:hidden xl:hidden absolute bottom-0 -top-[50px] -left-[620px] pointer-events-none z-20 rotate-[50deg]">
          <img src="/images/es/pop1.png" alt="Decorative Pattern" class="w-[120px] h-[120px] object-cover" />
        </div>

        <div class="block md:hidden lg:hidden xl:block absolute bottom-0 top-[550px] right-[280px] pointer-events-none z-20">
          <img src="/images/es/pop1.png" alt="Decorative Pattern" class="w-[103px] h-[103px] object-cover" />
        </div>

        <div class="block md:hidden lg:hidden xl:block absolute bottom-0 -top-[390px] -left-[1600px] pointer-events-none z-20 rotate-[50deg]">
          <img src="/images/es/pop1.png" alt="Decorative Pattern" class="w-[120px] h-[120px] object-cover" />
        </div>


         <div class="hidden md:hidden lg:block xl:hidden absolute bottom-0 top-[630px] right-[560px] pointer-events-none z-20">
          <img src="/images/es/pop1.png" alt="Decorative Pattern" class="w-[120px] h-[159px] object-cover" />
        </div>

        <div class="hidden md:hidden lg:block xl:hidden absolute bottom-0 top-[90px] -left-[320px] pointer-events-none z-20 rotate-[50deg]">
          <img src="/images/es/pop1.png" alt="Decorative Pattern" class="w-[120px] h-[120px] object-cover" />
        </div>

      <!-- Tabs/Filtros -->
      <div class="flex flex-wrap gap-3" id="productTabs">
        {categories.map((category, index) => (
          <button
            type="button"
            class={`tab-btn px-6 py-3 rounded-full font-bold text-base transition-all ${
              index === 0 
                ? 'bg-[#F9A825] text-white shadow-md' 
                : 'bg-[#FFF9E6] text-gray-700'
            }`}
            data-category={category.value}
          >
            {category.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Products Grid -->
    {products.length === 0 ? (
      <p class="text-center text-gray-500">
        {currentLang === 'es' ? 'No hay productos para mostrar.' : 'No products to display.'}
      </p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="products-grid">
        {products.map((product: any) => (
          <a
            href={`/${currentLang}/productos/${product.id}`}
            class="product-card group"
            data-category={product.category || 'all'}
          >
            <div 
              class="rounded-[30px] p-6 md:p-8 flex flex-col items-center justify-center transition-all duration-300 hover:shadow-2xl transform hover:scale-[1.02] min-h-[350px]"
              style={{ backgroundColor: product.background_product || '#FFFFFF' }}
            >
              <img
                src={product.image || '/images/products/placeholder.jpg'}
                alt={product.name}
                class="w-full max-w-[250px] h-[250px] object-contain drop-shadow-lg group-hover:scale-105 transition-transform duration-300"
              />
            </div>

            <!-- Título fuera de la tarjeta -->
            <h3 class="text-xl md:text-2xl font-black text-gray-900 mt-4 leading-tight">
              {product.name}
            </h3>
          </a>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .product-card {
    display: block;
    text-decoration: none;
  }

  .nacho-pattern {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0.50;
      pointer-events: none;
      z-index: 1;
      background-repeat: repeat;
      background-size: 1000px auto;
      background-position: center;
  }
</style>

<script>
  function initProductFilters() {
    const tabs = document.querySelectorAll('.tab-btn');
    const productCards = document.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;

    function filterProducts(category: string) {
      productCards.forEach((card) => {
        const productCategory = card.getAttribute('data-category');
        
        if (category === 'all' || productCategory === category) {
          card.style.display = 'block';
          // Fade in animation
          card.style.opacity = '0';
          setTimeout(() => {
            card.style.opacity = '1';
            card.style.transition = 'opacity 0.3s ease-in-out';
          }, 10);
        } else {
          card.style.display = 'none';
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        // Update active tab styles
        tabs.forEach(t => {
          t.classList.remove('bg-[#F9A825]', 'text-white', 'shadow-md');
          t.classList.add('bg-[#FFF9E6]', 'text-gray-700');
        });
        
        tab.classList.remove('bg-[#FFF9E6]', 'text-gray-700');
        tab.classList.add('bg-[#F9A825]', 'text-white', 'shadow-md');

        // Filter products
        const category = tab.getAttribute('data-category') || 'all';
        filterProducts(category);
      });
    });

    // Initialize - show all products
    filterProducts('all');
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductFilters);
  } else {
    initProductFilters();
  }

  // Re-initialize on Astro page navigation
  document.addEventListener('astro:page-load', initProductFilters);
</script>