---
// src/components/pages/ProductsPage.astro
import LazyImage from '../../components/common/LazyImage.astro';
import { t } from '../../i18n/i18n';
import type { Locale } from '../../i18n/i18n';
import { getLocale } from '../../i18n/i18n';

const currentLang = getLocale();
const products = t('items', { namespace: 'products', locale: currentLang }) || [];

// Read category from URL parameter
const url = Astro.url;
const urlParams = new URLSearchParams(url.search);
const selectedCategory = urlParams.get('category') || 'all';
const heroProducts = (products as any[]).slice(0, 3);
const productsImages = heroProducts.map((p: any) => ({ image: p.image, name: p.name, isnew: p.isnew }));


// Textos
const heroTitle = currentLang === 'es' ? 'Descubre nuestros sabores' : 'Discover our flavors';
const heroSubtitle = currentLang === 'es' ? 'Cada snack para cada momento inolvidable.' : 'Every snack for every unforgettable moment.';
const heroButton = currentLang === 'es' ? 'Explorar ahora' : 'Explore now';
const sectionTitle = currentLang === 'es' ? 'Todos los productos' : 'All products';

// Categorías/filtros
const categories = [
  { label: currentLang === 'es' ? 'Todos' : 'All', value: 'all' },
  { label: 'Yummi Pops Nacho', value: 'nacho' },
  { label: currentLang === 'es' ? 'Yummi Pops Palomitas' : 'Yummi Pops Popcorn', value: 'palomitas' }
];

// Group products by category
const categoryGroups = [
  {
    key: 'nacho',
    label: 'Yummi Pops Nacho',
    products: (products as any[]).filter((p: any) => p.category === 'nacho'),
  },
  {
    key: 'palomitas',
    label: currentLang === 'es' ? 'Yummi Pops Palomitas' : 'Yummi Pops Popcorn',
    products: (products as any[]).filter((p: any) => p.category === 'palomitas'),
  },
].filter(g => g.products.length > 0);

// Features del hero
const features = [
  {
    icon: '/images/es/grasa.png'
  },
  {
    icon: '/images/es/gluten.png'
  },
  {
    icon: '/images/es/maiz.png'
  }
];
---

<!-- Hero Section -->
<section class="hidden xl:block relative bg-[#2392D3] to-blue-500 rounded-[30px] md:rounded-[40px] mx-4 md:mx-8 mt-8 mb-12 overflow-hidden">
  <div class="container mx-auto px-6 md:px-12 py-12 md:py-16 lg:py-20">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 items-center">
      <div class="nacho-pattern" style="background-image: url('/images/es/bg-product.png');"></div>
      <!-- Lado Izquierdo - Contenido -->
      <div class="text-white space-y-6 z-10 relative pl-[20px]">
        <div class="hidden xl:block">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight">
          {heroTitle}
          </h1>
          <p class="text-lg md:text-xl mb-8">
            {heroSubtitle}
          </p>
          
          <a href="#productsSection" onclick="event.preventDefault();document.getElementById('productsSection').scrollIntoView({behavior:'smooth'})" class="inline-block bg-white text-black font-bold px-8 py-3 rounded-full hover:bg-gray-100 transition-all transform hover:scale-105 shadow-lg cursor-pointer">
            {heroButton}
          </a>
        </div>

        <!-- Features -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 pt-2">
          {features.map((feature) => (
            <div class="text-center">
              <LazyImage
                src={feature.icon}
                alt="Feature Icon"
                class="w-[163px] h-[63px] object-contain mx-auto mb-2"
              />
            </div>
          ))}
        </div>
      </div>

      <!-- Lado Derecho - Montaje grupo escalable -->
      <div class="hidden xl:flex items-center justify-center w-full">
        <div class="relative w-full" style="aspect-ratio: 5/4;">

          <!-- 4 chips decorativos en esquinas -->
          <img src="/images/es/pop1.png" alt="" class="absolute object-contain" style="width: 14%; left: 0%; top: 2%; transform: rotate(-52deg); z-index: 40; animation: floatChip 3s ease-in-out infinite;" />
          <img src="/images/es/pop1.png" alt="" class="absolute object-contain" style="width: 13%; right: 0%; top: 5%; transform: rotate(38deg); z-index: 40; animation: floatChip 3s ease-in-out infinite 0.7s;" />
          <img src="/images/es/pop1.png" alt="" class="absolute object-contain" style="width: 15%; left: 1%; bottom: 2%; transform: rotate(67deg); z-index: 40; animation: floatChip 3s ease-in-out infinite 1.4s;" />
          <img src="/images/es/pop1.png" alt="" class="absolute object-contain" style="width: 12%; right: 1%; bottom: 4%; transform: rotate(-43deg); z-index: 40; animation: floatChip 3s ease-in-out infinite 2.1s;" />

          <!-- Empaque izquierdo -->
          <div class="absolute" style="width: 36%; right: 54%; top: 18%; transform: rotate(-12deg); z-index: 10;">
            <div class="relative">
              <img src={productsImages[1]?.image || '/images/products/placeholder.jpg'} alt="chip" class="w-full h-auto object-contain drop-shadow-xl" style="animation: floatChip 3s ease-in-out infinite;" />
              {productsImages[1]?.isnew && (
                <img 
                  src={currentLang === 'es' ? 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NUEVO.webp' : 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NEW.webp'}
                  alt="NEW"
                      class="product-new-badge-left product-new-badge-hero"
                />
              )}
            </div>
          </div>
          <!-- Empaque central -->
          <div class="absolute" style="width: 46%; left: 50%; top: 0%; transform: translateX(-50%); z-index: 30;">
            <div class="relative">
              <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/yummi-chile-toreado.webp" alt={productsImages[0]?.name || 'product'} class="w-full h-auto object-contain drop-shadow-2xl" />
              <img 
                src={currentLang === 'es' ? 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NUEVO.webp' : 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NEW.webp'}
                alt="NEW"
                class="product-new-badge product-new-badge-hero"
              />
            </div>
          </div>
          <!-- Empaque derecho -->
          <div class="absolute" style="width: 36%; left: 54%; top: 18%; transform: rotate(12deg); z-index: 10;">
            <div class="relative">
              <img src={productsImages[2]?.image || productsImages[1]?.image || '/images/products/placeholder.jpg'} alt="chip" class="w-full h-auto object-contain drop-shadow-xl" style="animation: floatChip 3s ease-in-out infinite 1.5s;" />
              {productsImages[2]?.isnew && (
                <img 
                  src={currentLang === 'es' ? 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NUEVO.webp' : 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NEW.webp'}
                  alt="NEW"
                      class="product-new-badge product-new-badge-hero"
                />
              )}
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<!-- Hero responsive unificado: mobile → lg (< 1280px) -->
<section class="block xl:hidden relative bg-[#2392D3] rounded-[30px] mx-4 mt-8 mb-12 overflow-hidden">
  <div class="nacho-pattern" style="background-image: url('/images/es/bg-product.png');"></div>
  <div class="relative z-10 px-6 pt-8 pb-6 md:pt-12 md:pb-8 flex flex-col items-center gap-2">

    <!-- Features icons -->
    <div class="grid grid-cols-3 gap-3 w-full max-w-xs md:max-w-sm z-40">
      {features.map((feature) => (
        <div class="text-center">
          <LazyImage
            src={feature.icon}
            alt="Feature Icon"
            class="w-full max-w-[80px] md:max-w-[110px] h-auto object-contain mx-auto"
          />
        </div>
      ))}
    </div>

    <!-- Montaje: grupo escalable como unidad -->
    <div class="relative w-full flex justify-center">
      <!-- Grupo escalable: todo dentro escala junto en % -->
      <div class="relative" style="width: min(90vw, 500px); aspect-ratio: 5/4;">

        <!-- 4 chips decorativos en esquinas (% del grupo) -->
        <img src="/images/es/pop1.png" alt="" class="absolute object-contain" style="width: 14%; left: 0%; top: 2%; transform: rotate(-55deg); z-index: 40; animation: floatChip 3s ease-in-out infinite;" />
        <img src="/images/es/pop1.png" alt="" class="absolute object-contain" style="width: 13%; right: 0%; top: 5%; transform: rotate(42deg); z-index: 40; animation: floatChip 3s ease-in-out infinite 0.7s;" />
        <img src="/images/es/pop1.png" alt="" class="absolute object-contain" style="width: 15%; left: 1%; bottom: 2%; transform: rotate(71deg); z-index: 40; animation: floatChip 3s ease-in-out infinite 1.4s;" />
        <img src="/images/es/pop1.png" alt="" class="absolute object-contain" style="width: 12%; right: 1%; bottom: 4%; transform: rotate(-38deg); z-index: 40; animation: floatChip 3s ease-in-out infinite 2.1s;" />

        <!-- Empaque izquierdo -->
        <div class="absolute" style="width: 36%; right: 54%; top: 18%; transform: rotate(-12deg); z-index: 10;">
          <div class="relative">
            <img src={productsImages[1]?.image || '/images/products/placeholder.jpg'} alt="chip" class="w-full h-auto object-contain drop-shadow-xl" style="animation: floatChip 3s ease-in-out infinite;" />
            {productsImages[1]?.isnew && (
              <img 
                src={currentLang === 'es' ? 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NUEVO.webp' : 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NEW.webp'}
                alt="NEW"
                class="product-new-badge-left product-new-badge-hero"
              />
            )}
          </div>
        </div>
        <!-- Empaque central (más grande, al frente) -->
        <div class="absolute" style="width: 46%; left: 50%; top: 0%; transform: translateX(-50%); z-index: 30;">
          <div class="relative">
            <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/yummi-chile-toreado.webp" alt={productsImages[0]?.name || 'product'} class="w-full h-auto object-contain drop-shadow-2xl" />
            <img 
              src={currentLang === 'es' ? 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NUEVO.webp' : 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NEW.webp'}
              alt="NEW"
              class="product-new-badge-left product-new-badge-hero"
            />
          </div>
        </div>
        <!-- Empaque derecho -->
        <div class="absolute" style="width: 36%; left: 54%; top: 18%; transform: rotate(12deg); z-index: 10;">
          <div class="relative">
            <img src={productsImages[2]?.image || productsImages[1]?.image || '/images/products/placeholder.jpg'} alt="chip" class="w-full h-auto object-contain drop-shadow-xl" style="animation: floatChip 3s ease-in-out infinite 1.5s;" />
            {productsImages[2]?.isnew && (
              <img 
                src={currentLang === 'es' ? 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NUEVO.webp' : 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NEW.webp'}
                alt="NEW"
                class="product-new-badge product-new-badge-hero"
              />
            )}
          </div>
        </div>

      </div>
    </div>

    <!-- Texto -->
    <div class="text-white text-center w-full max-w-lg">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-black leading-tight mb-3">
        {heroTitle}
      </h1>
      <p class="text-base md:text-lg mb-6">{heroSubtitle}</p>
      <a href="#productsSection" onclick="event.preventDefault();document.getElementById('productsSection').scrollIntoView({behavior:'smooth'})" class="inline-block bg-white text-black font-bold px-8 py-3 rounded-full hover:bg-gray-100 transition-all transform hover:scale-105 shadow-lg cursor-pointer">
        {heroButton}
      </a>
    </div>

  </div>
</section>

<!-- Products Section -->
<div id="productsSection" class="bg-white py-12">
  <div class="container mx-auto px-4">

    <!-- Header -->
    <div class="mb-8">
      <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-6">
        {sectionTitle}
      </h2>
      

      <!-- Tabs/Filtros -->
      <div class="flex flex-wrap gap-3" id="productTabs">
        {categories.map((category, index) => (
          <button
            type="button"
            class={`tab-btn px-6 py-3 rounded-full font-bold text-base transition-all ${
              index === 0 
                ? 'bg-[#F9A825] text-white shadow-md' 
                : 'bg-[#FFF9E6] text-gray-700'
            }`}
            data-category={category.value}
          >
            {category.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Products Grid -->
    {products.length === 0 ? (
      <p class="text-center text-gray-500">
        {currentLang === 'es' ? 'No hay productos para mostrar.' : 'No products to display.'}
      </p>
    ) : (
      <div id="products-container">

        {/* === VISTA AGRUPADA (all) === */}
        <div id="grouped-view">
          {categoryGroups.map((group) => {
            // Ancla dependiente del idioma: nacho → nacho, palomitas → palomitas (ES) / popcorn (EN)
            const anchorId = group.key === 'palomitas' && currentLang === 'en' ? 'popcorn' : group.key;
            return (
            <div class="category-group mb-12" id={anchorId} data-group={group.key}>
              <h3 class="text-2xl md:text-3xl font-black text-gray-900 mb-6">{group.label}</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                {group.products.map((product: any) => (
                  <a
                    href={`/${currentLang}/${currentLang === 'es' ? 'productos' : 'products'}/${product.id}`}
                    class="product-card group"
                    data-category={product.category || 'all'}
                  >
                    <div
                      class="rounded-[30px] p-6 md:p-8 flex flex-col items-center justify-center transition-all duration-300 hover:shadow-2xl transform hover:scale-[1.02] min-h-[350px] relative"
                      style={{ backgroundColor: product.background_product || '#FFFFFF' }}
                    >
                      <img
                        src={product.image || '/images/products/placeholder.jpg'}
                        alt={product.name}
                        class="w-full max-w-[250px] h-[250px] object-contain drop-shadow-lg group-hover:scale-105 transition-transform duration-300"
                      />
                      {product.isnew && (
                        <img 
                          src={currentLang === 'es' ? 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NUEVO.webp' : 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NEW.webp'}
                          alt="NEW"
                          class="product-new-badge"
                        />
                      )}
                      <!-- Nombre dentro de la card -->
                      <p class="w-full text-sm md:text-base font-black text-white leading-tight mt-4 text-center">
                        {product.name}
                      </p>
                    </div>
                    <h3 class="text-xl md:text-2xl font-black text-white mt-4 leading-tight">
                      {product.name}
                    </h3>
                  </a>
                ))}
              </div>
            </div>
            );
          })}
        </div>

        {/* === VISTA FILTRADA (categoría específica) === */}
        <div id="filtered-view" style="display:none">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="products-grid">
            {(products as any[]).map((product: any) => (
              <a
                href={`/${currentLang}/${currentLang === 'es' ? 'productos' : 'products'}/${product.id}`}
                class="product-card group"
                data-category={product.category || 'all'}
              >
                <div
                  class="rounded-[30px] p-6 md:p-8 flex flex-col items-center justify-center transition-all duration-300 hover:shadow-2xl transform hover:scale-[1.02] min-h-[350px] relative"
                  style={{ backgroundColor: product.background_product || '#FFFFFF' }}
                >
                  <img
                    src={product.image || '/images/products/placeholder.jpg'}
                    alt={product.name}
                    class="w-full max-w-[250px] h-[250px] object-contain drop-shadow-lg group-hover:scale-105 transition-transform duration-300"
                  />
                  {product.isnew && (
                    <img 
                      src={currentLang === 'es' ? 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NUEVO.webp' : 'https://snack.yummiespromociones.com/SnacksyummiesAssets/NEW.webp'}
                      alt="NEW"
                      class="product-new-badge"
                    />
                  )}
                  <!-- Nombre dentro de la card -->
                  <p class="w-full text-sm md:text-base font-black text-white leading-tight mt-4 text-center">
                    {product.name}
                  </p>
                </div>
                <h3 class="text-xl md:text-2xl font-black text-white mt-4 leading-tight">
                  {product.name}
                </h3>
              </a>
            ))}
          </div>
        </div>

      </div>
    )}
  </div>
</div>

<style>
  @keyframes floatChip {
    0%   { transform: translateY(0px); }
    50%  { transform: translateY(-14px); }
    100% { transform: translateY(0px); }
  }

  .product-card {
    display: block;
    text-decoration: none;
  }

  .nacho-pattern {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0.50;
      pointer-events: none;
      z-index: 1;
      background-repeat: repeat;
      background-size: 1000px auto;
      background-position: center;
  }
</style>

<script>
  function initProductFilters() {
    const tabs = document.querySelectorAll('.tab-btn') as NodeListOf<HTMLElement>;
    const groupedView = document.getElementById('grouped-view') as HTMLElement;
    const filteredView = document.getElementById('filtered-view') as HTMLElement;
    const filteredCards = filteredView?.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;

    function applyCategory(category: string) {
      // Update active tab styles
      tabs.forEach(t => {
        if (t.getAttribute('data-category') === category) {
          t.classList.remove('bg-[#FFF9E6]', 'text-gray-700');
          t.classList.add('bg-[#F9A825]', 'text-white', 'shadow-md');
        } else {
          t.classList.remove('bg-[#F9A825]', 'text-white', 'shadow-md');
          t.classList.add('bg-[#FFF9E6]', 'text-gray-700');
        }
      });

      if (category === 'all') {
        // Show grouped view, hide filtered view
        groupedView.style.display = 'block';
        filteredView.style.display = 'none';
      } else {
        // Hide grouped view, show filtered view with matching cards
        groupedView.style.display = 'none';
        filteredView.style.display = 'block';
        filteredCards.forEach(card => {
          card.style.display = card.getAttribute('data-category') === category ? 'block' : 'none';
        });
      }

      // Update URL without reload
      const newUrl = new URL(window.location.href);
      if (category === 'all') {
        newUrl.searchParams.delete('category');
      } else {
        newUrl.searchParams.set('category', category);
      }
      window.history.replaceState({}, '', newUrl);
    }

    // Bind tab clicks
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const category = tab.getAttribute('data-category') || 'all';
        applyCategory(category);
      });
    });

    // Apply on load from URL
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('category') || 'all';
    applyCategory(initialCategory);
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductFilters);
  } else {
    initProductFilters();
  }

  // Re-initialize on Astro page navigation
  document.addEventListener('astro:page-load', initProductFilters);

  // Scroll suave al ancla indicada en la URL (hash)
  function scrollToHash() {
    const hash = window.location.hash;
    if (!hash) return;
    const id = hash.replace('#', '');
    let attempts = 0;
    const tryScroll = () => {
      const el = document.getElementById(id);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      if (++attempts < 10) setTimeout(tryScroll, 150);
    };
    setTimeout(tryScroll, 50);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scrollToHash);
  } else {
    scrollToHash();
  }
  document.addEventListener('astro:page-load', scrollToHash);
</script>