---
// src/views/Recipes/index.astro
import { getLocale } from '../../i18n/i18n';
import './styles.css';
import RecipeCard from '../../components/recipes/RecipeCard.astro';
import VideoModal from '../../components/common/VideoModal.astro';

interface Recipe {
  id: string;
  title: string;
  image?: string;
  preparation_time: number;
  type?: string;
  category?: string;
  product?: string | string[];
  difficulty?: string;
}

const currentLang = getLocale();

const recipeModules = import.meta.glob<{default: Recipe}>('../../locales/*/recipes/*.json');
const allRecipes: Recipe[] = [];

for (const path in recipeModules) {
  const lang = path.split('/')[3];
  if (lang === currentLang) {
    const module = await recipeModules[path]();
    allRecipes.push(module.default);
  }
}

function toDate(s?: string) {
  if (!s) return 0;
  const t = Date.parse(s);
  return isNaN(t) ? 0 : t;
}

allRecipes.sort((a, b) => toDate((b as any).date) - toDate((a as any).date));

const noRecipesText = currentLang === 'es' ? 'No hay recetas disponibles en este momento.' : 'No recipes available at this time.';
const noFilterResultsText = currentLang === 'es' ? 'No se encontraron resultados para la selección' : 'No results found for the selection';
const heroButton = currentLang === 'es' ? 'Ver ahora' : 'View now';
const sectionTitle = currentLang === 'es' ? 'Descubre nuestras recetas' : 'Discover our recipes';
const searchPlaceholder = currentLang === 'es' ? 'Encuentra tu receta favorita' : 'Find your favorite recipe';
const lineLabel = currentLang === 'es' ? 'Línea Yummi Pops' : 'Yummi Pops Line';
const categoryLabel = currentLang === 'es' ? 'Categorías' : 'Categories';
const personalizeButton = currentLang === 'es' ? 'Personalizar' : 'Customize';
const difficultyLabel = currentLang === 'es' ? 'Dificultad' : 'Difficulty';
const timeLabel = currentLang === 'es' ? 'Tiempo de preparación' : 'Preparation time';
const applyFiltersLabel = currentLang === 'es' ? 'Aplicar filtros' : 'Apply filters';
const clearFiltersLabel = currentLang === 'es' ? 'Limpiar filtros' : 'Clear filters';

const difficultyOptions = currentLang === 'es'
  ? { all: 'Todas', easy: 'Fácil', medium: 'Media', hard: 'Difícil' }
  : { all: 'All', easy: 'Easy', medium: 'Medium', hard: 'Hard' };

const timeOptions = currentLang === 'es'
  ? { all: 'Cualquier tiempo', quick: 'Menos de 15 min', medium: '15-30 min', long: 'Más de 30 min' }
  : { all: 'Any time', quick: 'Less than 15 min', medium: '15-30 min', long: 'More than 30 min' };

const filterLabels = currentLang === 'es'
  ? { all: 'Todos', breakfast: 'Desayuno', brunch: 'Brunch', lunch: 'Almuerzo', dinner: 'Cena', snack: 'Snack' }
  : { all: 'All', breakfast: 'Breakfast', brunch: 'Brunch', lunch: 'Lunch', dinner: 'Dinner', snack: 'Snack' };

function normalizeType(r: Recipe): string {
  const rawCategory = String((r as any).category || '').toLowerCase().trim();
  const categoryMap: Record<string, string> = { 'breakfast': 'breakfast', 'brunch': 'brunch', 'lunch': 'lunch', 'dinner': 'dinner', 'snack': 'snack' };
  return categoryMap[rawCategory] || 'other';
}

function normalizeDifficulty(r: Recipe): string {
  const raw = String(r.difficulty || '').toLowerCase().trim();
  if (raw.includes('fácil') || raw.includes('easy')) return 'easy';
  if (raw.includes('media') || raw.includes('medium') || raw.includes('intermedia')) return 'medium';
  if (raw.includes('difícil') || raw.includes('hard') || raw.includes('difficult')) return 'hard';
  return 'easy';
}

// filtro de categoria en recetas
const uniqueCategories = [...new Set(allRecipes.map(r => String((r as any).category || '').toLowerCase()).filter(Boolean))];

const categoryOptions = uniqueCategories.map(c => ({
  value: c,
  label: currentLang === 'es'
    ? (c === 'nacho' ? 'Con Yummi Pops Nacho' : c === 'palomitas' ? 'Con Yummi Pops Palomitas' : c)
    : (c === 'nacho' ? 'With Yummi Pops Nacho' : c === 'palomitas' ? 'With Yummi Pops Popcorn' : c)
}));

interface ProductItem { id: string; name: string; description?: string; }
const productModules = import.meta.glob<{ default: { items: ProductItem[] } }>('../../locales/*/products.json');
const productMap: Record<string, ProductItem> = {};

for (const path in productModules) {
  const lang = path.split('/')[3];
  if (lang === currentLang) {
    const mod = await productModules[path]();
    for (const item of (mod.default.items || [])) {
      productMap[item.id] = item;
    }
  }
}

// muestra categoria de productos unicamente a los que si tienen receta
const productsWithRecipes = new Set<string>();
for (const recipe of allRecipes) {
  const products = Array.isArray(recipe.product)
    ? recipe.product
    : recipe.product
    ? [recipe.product]
    : [];
  for (const p of products) {
    if (p) productsWithRecipes.add(p);
  }
}
const uniqueProducts = Object.keys(productMap).filter(id => productsWithRecipes.has(id));
const featuredRecipe = allRecipes[0];
---

<!-- Hero Section -->
<section class="relative bg-[#2392D3] to-blue-500 rounded-[30px] md:rounded-[40px] mx-4 md:mx-8 mt-8 mb-12 overflow-hidden">
  <div class="container mx-auto px-6 md:px-12 py-12 md:py-16 lg:py-20">
    {featuredRecipe && (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div class="nacho-pattern" style="background-image: url('/images/es/bg-product.png');"></div>
        <div class="relative rounded-3xl overflow-hidden z-40">
          <img src={featuredRecipe.image || '/images/recipes/placeholder.jpg'} alt={featuredRecipe.title} class="w-full h-[300px] md:h-[400px] object-cover rounded-3xl" />
          {(featuredRecipe as any).video && (
            <button
              type="button"
              data-video={(featuredRecipe as any).video}
              class="absolute inset-0 flex items-center justify-center bg-black/30 hover:bg-black/40 transition-colors cursor-pointer z-10 group/play"
              aria-label="Reproducir video"
            >
              <span class="w-20 h-20 rounded-full bg-[#F9A825] flex items-center justify-center shadow-lg group-hover/play:scale-110 transition-transform">
                <svg class="w-9 h-9 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </span>
            </button>
          )}
        </div>
        <div class="text-white space-y-6">
          <a href={`/${currentLang}/${currentLang === 'es' ? 'recetas' : 'recipes'}/${featuredRecipe.id}`} class="block group/hero">
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-black leading-tight group-hover/hero:text-[#F9A825] transition-colors">{featuredRecipe.title}</h1>
          </a>
          <p class="text-base md:text-lg">{featuredRecipe.description || (currentLang === 'es' ? 'Descripción no disponible.' : 'Description not available.')}</p>
          <a href={`/${currentLang}/${currentLang === 'es' ? 'recetas' : 'recipes'}/${featuredRecipe.id}`} class="block text-sm font-light text-white/80 hover:text-[#F9A825] transition-colors">
            {currentLang === 'es' ? 'Ver más detalles →' : 'View more details →'}
          </a>
          <a href={`/${currentLang}/${currentLang === 'es' ? 'recetas' : 'recipes'}/${featuredRecipe.id}`} class="inline-block bg-white text-blue-600 font-bold px-8 py-3 rounded-full hover:bg-gray-100 transition-all transform hover:scale-105 shadow-lg">{heroButton}</a>
        </div>
      </div>
    )}
  </div>
  <div class="absolute top-10 right-20 w-64 h-64 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 left-20 w-80 h-80 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
</section>

<!-- Main Content -->
<div class="bg-white pb-16">
  <div class="container mx-auto px-4 md:px-8">

    <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-8">{sectionTitle}</h2>

    <!-- Search and Filters -->
    <div class="flex flex-col md:flex-row gap-4 mb-6">
      <div class="relative flex-1">
        <input type="text" id="searchInput" placeholder={searchPlaceholder} class="w-full px-6 py-3 pr-14 rounded-full border-2 border-gray-200 focus:border-orange focus:outline-none transition-colors" />
        <button type="button" id="searchBtn" onclick="window.currentPage=1; window.applyAllFilters();" class="absolute right-4 top-1/2 -translate-y-1/2 p-2 text-gray-400 hover:text-gray-600 transition-colors cursor-pointer" aria-label="Search">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </button>
      </div>

      <div class="relative custom-dropdown-wrapper" id="productFilterWrapper">
        <button
          type="button"
          id="productFilterBtn"
          class="flex items-center justify-between gap-3 bg-white rounded-full px-6 py-3 text-base font-medium border-2 border-gray-200 cursor-pointer hover:border-gray-300 transition-colors focus:outline-none w-full md:min-w-[220px]"
          onclick="window.toggleCustomDropdown('productFilter')"
          aria-expanded="false"
          aria-haspopup="listbox"
        >
          <span id="productFilterLabel">{lineLabel}</span>
          <svg class="w-4 h-4 flex-shrink-0 transition-transform duration-200" id="productFilterArrow" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </button>
        <ul
          id="productFilterDropdown"
          class="custom-dropdown-panel hidden absolute left-0 bg-white border border-gray-200 rounded-2xl shadow-2xl overflow-y-auto"
          role="listbox"
          aria-labelledby="productFilterBtn"
        >
          <li>
            <button type="button" class="custom-dropdown-option selected" data-filter="productFilter" data-value="all" data-label={lineLabel} role="option" aria-selected="true">{lineLabel}</button>
          </li>
          {uniqueProducts.map(productId => (
            <li>
              <button type="button" class="custom-dropdown-option" data-filter="productFilter" data-value={productId} data-label={productMap[productId]?.name || productId} role="option" aria-selected="false">
                {productMap[productId]?.name || productId}
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="relative custom-dropdown-wrapper" id="typeFilterWrapper">
        <button
          type="button"
          id="typeFilterBtn"
          class="flex items-center justify-between gap-3 bg-white rounded-full px-6 py-3 text-base font-medium border-2 border-gray-200 cursor-pointer hover:border-gray-300 transition-colors focus:outline-none w-full md:min-w-[200px]"
          onclick="window.toggleCustomDropdown('typeFilter')"
          aria-expanded="false"
          aria-haspopup="listbox"
        >
          <span id="typeFilterLabel">{categoryLabel}</span>
          <svg class="w-4 h-4 flex-shrink-0 transition-transform duration-200" id="typeFilterArrow" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </button>
        <ul
          id="typeFilterDropdown"
          class="custom-dropdown-panel hidden absolute left-0 bg-white border border-gray-200 rounded-2xl shadow-2xl overflow-y-auto"
          role="listbox"
          aria-labelledby="typeFilterBtn"
        >
          <li>
            <button type="button" class="custom-dropdown-option selected" data-filter="typeFilter" data-value="all" data-label={categoryLabel} role="option" aria-selected="true">{categoryLabel}</button>
          </li>
          {categoryOptions.map(opt => (
            <li>
              <button type="button" class="custom-dropdown-option" data-filter="typeFilter" data-value={opt.value} data-label={opt.label} role="option" aria-selected="false">{opt.label}</button>
            </li>
          ))}
        </ul>
      </div>

      <!-- Personalize Button - CON ONCLICK DIRECTO -->
      <button 
        type="button"
        id="personalizeBtn"
        onclick="window.togglePersonalizePanel()"
        class="hidden md:flex items-center gap-2 bg-white rounded-full px-6 py-3 border-2 border-gray-200 font-medium hover:border-gray-300 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
        </svg>
        {personalizeButton}
        <svg id="personalizeArrow" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
    </div>

    <!-- Panel de Personalización (oculto por defecto) -->
    <div id="personalizePanel" class="hidden mb-8 p-6 bg-gray-50 rounded-2xl border border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Filtro de Dificultad -->
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">{difficultyLabel}</label>
          <div class="flex flex-wrap gap-2">
            <button type="button" onclick="window.selectDifficulty('all')" class="difficulty-btn active" data-value="all">{difficultyOptions.all}</button>
            <button type="button" onclick="window.selectDifficulty('easy')" class="difficulty-btn" data-value="easy">{difficultyOptions.easy}</button>
            <button type="button" onclick="window.selectDifficulty('medium')" class="difficulty-btn" data-value="medium">{difficultyOptions.medium}</button>
            <button type="button" onclick="window.selectDifficulty('hard')" class="difficulty-btn" data-value="hard">{difficultyOptions.hard}</button>
          </div>
        </div>

        <!-- Filtro de Tiempo -->
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">{timeLabel}</label>
          <div class="flex flex-wrap gap-2">
            <button type="button" onclick="window.selectTime('all')" class="time-btn active" data-value="all">{timeOptions.all}</button>
            <button type="button" onclick="window.selectTime('quick')" class="time-btn" data-value="quick">{timeOptions.quick}</button>
            <button type="button" onclick="window.selectTime('medium')" class="time-btn" data-value="medium">{timeOptions.medium}</button>
            <button type="button" onclick="window.selectTime('long')" class="time-btn" data-value="long">{timeOptions.long}</button>
          </div>
        </div>

        <!-- Botones de Acción -->
        <div class="lg:col-span-2 flex items-end justify-end gap-3">
          <button type="button" onclick="window.clearCustomFilters()" class="px-6 py-2 rounded-full text-sm font-medium text-gray-600 hover:text-gray-800 transition-colors">{clearFiltersLabel}</button>
          <button type="button" onclick="window.applyAllFilters()" class="px-6 py-2 rounded-full text-sm font-bold bg-[#F9A825] text-white hover:bg-[#F57C00] transition-colors">{applyFiltersLabel}</button>
        </div>
      </div>
    </div>

    <!-- Recipes Grid -->
    {allRecipes.length === 0 ? (
      <p class="text-center text-gray-500 py-12">{noRecipesText}</p>
    ) : (
      <>
        <div id="recipesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {allRecipes.map((recipe: Recipe) => (
            <div class="recipe-card" data-category={(recipe as any).category || 'other'} data-products={(Array.isArray(recipe.product) ? recipe.product : (recipe.product ? [recipe.product] : [])).join(',')} data-title={recipe.title.toLowerCase()} data-difficulty={normalizeDifficulty(recipe)} data-time={recipe.preparation_time}>
              <RecipeCard image={recipe.image || '/images/recipes/placeholder.jpg'} title={recipe.title} time={`${recipe.preparation_time}MIN`} id={recipe.id} difficulty={recipe.difficulty || (currentLang === 'es' ? 'Fácil' : 'Easy')} product={Array.isArray(recipe.product) ? recipe.product[0] : recipe.product} video={(recipe as any).video} />
            </div>
          ))}
        </div>

        <div id="noResults" class="hidden mt-12 flex items-center justify-center h-48">
          <p class="text-gray-500 text-lg font-medium">{noFilterResultsText}</p>
        </div>

        <div id="paginationContainer" class="flex justify-center items-center gap-2 mt-12">
          <!-- Los botones se generarán dinámicamente -->
        </div>
      </>
    )}
  </div>
</div>

<style>
  .nacho-pattern {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    opacity: 0.50; pointer-events: none; z-index: 1;
    background-repeat: repeat; background-size: 700px auto; background-position: center;
  }

  .difficulty-btn, .time-btn {
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    background-color: white;
    border: 2px solid #e5e7eb;
    color: #374151;
    cursor: pointer;
    transition: all 0.2s;
  }

  .difficulty-btn:hover, .time-btn:hover {
    border-color: #F9A825;
  }

  .difficulty-btn.active, .time-btn.active {
    background-color: #F9A825 !important;
    border-color: #F9A825 !important;
    color: white !important;
  }

  select, input { background-image: none; }

  /* Custom dropdown panel */
  .custom-dropdown-panel {
    top: calc(100% + 8px);
    min-width: 100%;
    width: max-content;
    max-width: 340px;
    max-height: 280px;
    z-index: 9999;
  }

  /* On mobile: full width of its container */
  @media (max-width: 767px) {
    .custom-dropdown-panel {
      left: 0 !important;
      right: 0 !important;
      width: 100%;
      max-width: 100%;
      max-height: 260px;
    }
    .custom-dropdown-wrapper {
      width: 100%;
    }
  }

  /* Option items */
  .custom-dropdown-option {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.875rem 1.25rem;
    font-size: 1rem;        /* 16px – prevents iOS zoom */
    font-weight: 500;
    color: #374151;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background-color 0.15s;
    line-height: 1.4;
    min-height: 48px;       /* comfortable touch target */
  }

  .custom-dropdown-option:hover {
    background-color: #f9fafb;
  }

  .custom-dropdown-option.selected {
    background-color: #eff6ff;
    color: #2563eb;
    font-weight: 600;
  }

  .custom-dropdown-option.selected::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    background-color: #2563eb;
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: middle;
    position: relative;
    top: -1px;
  }

  /* Divider between options */
  .custom-dropdown-panel li + li .custom-dropdown-option {
    border-top: 1px solid #f3f4f6;
  }

  /* Active border on the trigger button */
  .custom-dropdown-btn-active {
    border-color: #F9A825 !important;
  }
</style>

<script is:inline>
// Variables globales en window para que funcionen los onclick
window.customDifficulty = 'all';
window.customTime = 'all';
window.currentPage = 1;
window.itemsPerPage = 6; // Recetas por página

// ── Custom dropdown values ──────────────────────────────────────────
window.productFilterValue = 'all';
window.typeFilterValue    = 'all';

// Toggle a custom dropdown open/close
window.toggleCustomDropdown = function(filterId) {
  var dropdown = document.getElementById(filterId + 'Dropdown');
  var arrow    = document.getElementById(filterId + 'Arrow');
  var btn      = document.getElementById(filterId + 'Btn');
  if (!dropdown) return;

  var isOpen = !dropdown.classList.contains('hidden');

  // Close every dropdown first
  window.closeAllCustomDropdowns();

  if (!isOpen) {
    dropdown.classList.remove('hidden');
    if (arrow) arrow.style.transform = 'rotate(180deg)';
    if (btn)   {
      btn.setAttribute('aria-expanded', 'true');
      btn.classList.add('custom-dropdown-btn-active');
    }
  }
};

// Close all custom dropdowns
window.closeAllCustomDropdowns = function() {
  ['productFilter', 'typeFilter'].forEach(function(id) {
    var dropdown = document.getElementById(id + 'Dropdown');
    var arrow    = document.getElementById(id + 'Arrow');
    var btn      = document.getElementById(id + 'Btn');
    if (dropdown) dropdown.classList.add('hidden');
    if (arrow)    arrow.style.transform = 'rotate(0deg)';
    if (btn)      {
      btn.setAttribute('aria-expanded', 'false');
      btn.classList.remove('custom-dropdown-btn-active');
    }
  });
};

// Close when tapping/clicking outside
document.addEventListener('click', function(e) {
  var wrappers = document.querySelectorAll('.custom-dropdown-wrapper');
  var inside = false;
  wrappers.forEach(function(w) { if (w.contains(e.target)) inside = true; });
  if (!inside) window.closeAllCustomDropdowns();
});

// Handle option selection (event delegation)
document.addEventListener('click', function(e) {
  var option = e.target.closest('.custom-dropdown-option');
  if (!option) return;

  var filterId = option.getAttribute('data-filter');
  var value    = option.getAttribute('data-value');
  var label    = option.getAttribute('data-label');

  // Store value
  if (filterId === 'productFilter') {
    window.productFilterValue = value;
    var lbl = document.getElementById('productFilterLabel');
    if (lbl) lbl.textContent = label;
  } else if (filterId === 'typeFilter') {
    window.typeFilterValue = value;
    var lbl = document.getElementById('typeFilterLabel');
    if (lbl) lbl.textContent = label;
  }

  // Update selected state on options
  document.querySelectorAll('[data-filter="' + filterId + '"].custom-dropdown-option').forEach(function(opt) {
    var isSelected = opt.getAttribute('data-value') === value;
    opt.classList.toggle('selected', isSelected);
    opt.setAttribute('aria-selected', isSelected ? 'true' : 'false');
  });

  // Close dropdown & re-filter
  window.closeAllCustomDropdowns();
  window.currentPage = 1;
  window.applyAllFilters();
});

// Toggle del panel
window.togglePersonalizePanel = function() {
  var panel = document.getElementById('personalizePanel');
  var arrow = document.getElementById('personalizeArrow');
  
  if (panel.classList.contains('hidden')) {
    panel.classList.remove('hidden');
    if (arrow) arrow.style.transform = 'rotate(180deg)';
  } else {
    panel.classList.add('hidden');
    if (arrow) arrow.style.transform = 'rotate(0deg)';
  }
};

// Seleccionar dificultad
window.selectDifficulty = function(value) {
  window.customDifficulty = value;
  document.querySelectorAll('.difficulty-btn').forEach(function(btn) {
    if (btn.getAttribute('data-value') === value) {
      btn.classList.add('active');
    } else {
      btn.classList.remove('active');
    }
  });
};

// Seleccionar tiempo
window.selectTime = function(value) {
  window.customTime = value;
  document.querySelectorAll('.time-btn').forEach(function(btn) {
    if (btn.getAttribute('data-value') === value) {
      btn.classList.add('active');
    } else {
      btn.classList.remove('active');
    }
  });
};

// Limpiar filtros
window.clearCustomFilters = function() {
  window.selectDifficulty('all');
  window.selectTime('all');
  window.currentPage = 1;
  window.applyAllFilters();
};

// Ir a página específica
window.goToPage = function(page) {
  window.currentPage = page;
  window.applyAllFilters();
  // Scroll suave hacia arriba del grid
  var grid = document.getElementById('recipesGrid');
  if (grid) {
    grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
};

// Página anterior
window.prevPage = function() {
  if (window.currentPage > 1) {
    window.currentPage--;
    window.applyAllFilters();
    var grid = document.getElementById('recipesGrid');
    if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
};

// Página siguiente
window.nextPage = function(totalPages) {
  if (window.currentPage < totalPages) {
    window.currentPage++;
    window.applyAllFilters();
    var grid = document.getElementById('recipesGrid');
    if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
};

// Aplicar filtros
window.applyAllFilters = function() {
  var searchInput = document.getElementById('searchInput');
  var recipesGrid = document.getElementById('recipesGrid');
  var noResults = document.getElementById('noResults');

  var searchValue  = searchInput ? searchInput.value.toLowerCase().trim() : '';
  var typeValue    = window.typeFilterValue    || 'all';
  var productValue = window.productFilterValue || 'all';

  var cards = document.querySelectorAll('.recipe-card');
  var filteredCards = [];

  // Primero, filtrar las cards
  cards.forEach(function(card) {
    var cardType = card.getAttribute('data-category') || '';
    var cardProducts = (card.getAttribute('data-products') || '').split(',');
    var cardTitle = card.getAttribute('data-title') || '';
    var cardDiff = card.getAttribute('data-difficulty') || 'easy';
    var cardTime = parseInt(card.getAttribute('data-time') || '0');

    var ok1 = searchValue === '' || cardTitle.indexOf(searchValue) >= 0;
    var ok2 = typeValue === 'all' || cardType === typeValue;
    var ok3 = productValue === 'all' || cardProducts.indexOf(productValue) >= 0;
    var ok4 = window.customDifficulty === 'all' || cardDiff === window.customDifficulty;
    
    var ok5 = true;
    if (window.customTime === 'quick') ok5 = cardTime < 15;
    else if (window.customTime === 'medium') ok5 = cardTime >= 15 && cardTime <= 30;
    else if (window.customTime === 'long') ok5 = cardTime > 30;

    if (ok1 && ok2 && ok3 && ok4 && ok5) {
      filteredCards.push(card);
    }
  });

  // Calcular paginación
  var totalItems = filteredCards.length;
  var totalPages = Math.ceil(totalItems / window.itemsPerPage);
  
  // Asegurar que la página actual es válida
  if (window.currentPage > totalPages) window.currentPage = totalPages;
  if (window.currentPage < 1) window.currentPage = 1;

  var startIndex = (window.currentPage - 1) * window.itemsPerPage;
  var endIndex = startIndex + window.itemsPerPage;

  // Ocultar todas las cards primero
  cards.forEach(function(card) {
    card.style.display = 'none';
  });

  // Mostrar solo las cards de la página actual
  var visibleCount = 0;
  filteredCards.forEach(function(card, index) {
    if (index >= startIndex && index < endIndex) {
      card.style.display = '';
      visibleCount++;
    }
  });

  // Mostrar/ocultar grid y mensaje de no resultados
  if (recipesGrid) recipesGrid.style.display = totalItems > 0 ? '' : 'none';
  if (noResults) {
    if (totalItems > 0) {
      noResults.classList.add('hidden');
      noResults.classList.remove('flex');
    } else {
      noResults.classList.remove('hidden');
      noResults.classList.add('flex');
    }
  }

  // Actualizar paginación
  updatePagination(totalPages);
};

// Actualizar botones de paginación
function updatePagination(totalPages) {
  var container = document.getElementById('paginationContainer');
  if (!container) return;

  // Si no hay páginas o solo hay una, ocultar paginación
  if (totalPages <= 1) {
    container.innerHTML = '';
    return;
  }

  var html = '';

  // Botón anterior
  html += '<button onclick="window.prevPage()" class="w-10 h-10 rounded-full ' + 
    (window.currentPage === 1 ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'bg-[#F9A825] text-white hover:bg-[#F57C00]') + 
    ' font-bold flex items-center justify-center transition-colors" ' + 
    (window.currentPage === 1 ? 'disabled' : '') + '>' +
    '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>' +
    '</button>';

  // Botones de página
  var startPage = Math.max(1, window.currentPage - 2);
  var endPage = Math.min(totalPages, startPage + 4);
  
  if (endPage - startPage < 4) {
    startPage = Math.max(1, endPage - 4);
  }

  for (var i = startPage; i <= endPage; i++) {
    var isActive = i === window.currentPage;
    html += '<button onclick="window.goToPage(' + i + ')" class="w-10 h-10 rounded-full ' + 
      (isActive ? 'bg-[#F9A825] text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300') + 
      ' font-bold flex items-center justify-center transition-colors">' + i + '</button>';
  }

  // Botón siguiente
  html += '<button onclick="window.nextPage(' + totalPages + ')" class="w-10 h-10 rounded-full ' + 
    (window.currentPage === totalPages ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'bg-[#F9A825] text-white hover:bg-[#F57C00]') + 
    ' font-bold flex items-center justify-center transition-colors" ' + 
    (window.currentPage === totalPages ? 'disabled' : '') + '>' +
    '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>' +
    '</button>';

  container.innerHTML = html;
}

// Inicializar filtros básicos
function initRecipeSearch() {
  var searchInput = document.getElementById('searchInput');

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      window.currentPage = 1;
      window.applyAllFilters();
    });

    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        window.currentPage = 1;
        window.applyAllFilters();
      }
    });
  }

  window.applyAllFilters();
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initRecipeSearch);
} else {
  initRecipeSearch();
}
</script>

