---
// src/views/Contact/index.astro
import { t, getLocale } from '../../i18n/i18n';
import type { Locale } from '../../i18n/i18n';
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb/Breadcrumb.astro';
import LazyImage from '../../components/common/LazyImage.astro';
import FormContact from '../../components/contact/FormContact.astro';
import { fade } from 'astro:transitions';

// Import locale files statically
import contactEs from '../../locales/es/contact.json';
import contactEn from '../../locales/en/contact.json';

// Importar estilos separados
import './styles.css';

interface Props {
  title?: string;
  class?: string;
  description?: string;
  currentLang?: Locale;
  headerColorConfig?: any;
}

const { currentLang, headerColorConfig } = Astro.props;

// Get current locale if not provided
const locale = currentLang || getLocale();

// Get contact data from locale
const contact = locale === 'es' ? contactEs : contactEn;

// Meta information
const title = contact.title;
const metaDescription = contact.description;
console.log('headerColorConfig in Contact:', headerColorConfig);
const headerColors = {
  backgroundColor: '#FAF0D5',
  textColor: '#FFFFFF'
};
---

<MainLayout title={title} class="bg-white" description={metaDescription}>
  <div class=" w-[100%] mx-auto ">
    

    <!-- Main Contact Section -->
    <div class="flex flex-col justify-center px-4 md:px-8 items-center xl:items-start xl:flex-row gap-8 xl:gap-12 py-8 md:py-12 bg-white">
      
      <!-- Left Column - Contact Info -->
      <div class="w-full xl:w-1/2 flex flex-col justify-center items-center xl:items-start text-center xl:text-left">
        <div class="text-black pb-3 text-base md:text-lg lg:text-xl">
          {contact.title}
        </div>
        <h1 class="text-black font-title text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl uppercase font-bold mb-4 md:mb-6 italic leading-tight">
          {contact.subtitle}
          {contact.subtitleTwo}
        </h1>
        
        <p class="text-black font-bold text-base md:text-lg lg:text-xl mb-6 md:mb-8 leading-relaxed max-w-lg xl:max-w-none">
          {contact.description}
        </p>
      </div>
      
      <!-- Right Column - Contact Form -->
      <div class="w-full xl:w-1/2">
        <FormContact currentLang={locale} />
      </div>
    </div>

    <!-- Offices Section -->
    <div class="mx-auto bg-blue px-4 md:px-8 py-8 z-30 relative">

      <h3 class="text-black text-2xl sm:text-3xl md:text-4xl lg:text-5xl italic font-title uppercase font-bold mb-2 text-center">
        <span class="font-title">{contact.offices.title.split(' ')[0]} {contact.offices.title.split(' ')[1]}</span>
      </h3>
      <h1 class="text-black text-2xl sm:text-3xl md:text-4xl lg:text-5xl italic font-title uppercase font-bold mb-6 text-center">
        <span class="font-title">{contact.offices.title.split(' ').slice(2).join(' ')}</span>
      </h1>
      
      <!-- Tabs and Office Info -->
      <div class="flex flex-col mb-4">
        <!-- Office Details -->
        <div class="order-2 w-full md:w-[90%] mx-auto">
          <div id="officeInfo" class="bg-blue rounded-2xl">
            <div class="flex flex-col lg:flex-row justify-between gap-6">
              <div class="space-y-3">
                <h3
                  id="officeName"
                  class="text-black font-sans text-3xl sm:text-4xl md:text-5xl lg:text-6xl uppercase font-extrabold mb-2 mt-4 leading-tight"
                >
                  {contact.offices.locations["+504"].name}
                </h3>
                
                <div class="flex items-start">
                  <p id="officeAddress" class="text-black leading-relaxed font-semibold text-base md:text-lg lg:text-xl">
                    {`+ ${contact.offices.locations["+504"].address}`}
                  </p>
                </div>
                
                <div class="flex items-center">
                  <div id="officePhones" class="flex flex-col gap-1">
                    {contact.offices.locations["+504"].phones.map((phone: string) => (
                      <div>
                        <a
                          href={`tel:${phone}`}
                          class="text-black text-base md:text-lg lg:text-xl hover:text-primary transition-colors"
                        >
                          {phone}
                        </a>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
          
              <div class="mt-2 lg:mt-0 lg:w-1/2">
                <LazyImage
                  alt="Yummies Honduras"
                  class="w-full h-48 md:h-64 object-cover rounded-xl"
                />
              </div>
            </div>
          </div>
        </div>
        
        <!-- Map and Tabs -->
        <div class="order-1 mt-4 z-30">
          <!-- Country Tabs -->
          <div class="mb-6 flex flex-col sm:flex-row sm:flex-wrap sm:justify-center gap-3 items-center">
          {Object.entries(contact.offices.locations).map(([countryCode, location]: [string, any], index: number) => (
            <button 
              data-country-code={countryCode}
              class={`country-tab w-full max-w-[340px] sm:w-auto px-8 sm:px-16 py-4 text-white uppercase text-sm font-semibold transition-all duration-300 flex items-center justify-center gap-2.5 h-[54px] bg-[#FBCC38] opacity-100 rounded-[47px]`}
            >
              {location.tab}
            </button>
          ))}
        </div>
          
          <!-- Map -->
          <div class="bg-gradient-to-br w-[90%] mx-auto bg-white rounded-2xl border-[2px] border-black p-6 shadow-lg mb-4">
            <div class="w-full  overflow-hidden rounded-xl" style="height: 500px;">
              <!-- Container for all map iframes -->
              <div id="maps-container" style="width: 100%; height: 100%;">
                {Object.entries(contact.offices.locations).map(([countryCode, location]: [string, any], index: number) => (
                  <div 
                    data-map-country={countryCode}
                    style={`width: 100%; height: 100%; ${index === 0 ? 'display: block;' : 'display: none;'}`}
                  >
                    <iframe
                      src={location.mapEmbed}
                      width="100%"
                      height="100%"
                      frameborder="0"
                      allowfullscreen="allowfullscreen"
                      aria-hidden="false"
                      style="width: 100%; height: 100%; border: 0;"
                      title={`${location.name} Map`}
                    ></iframe>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      (function() {
        // Función que se ejecutará cuando el DOM esté listo
        function initializeCountryTabs() {
          console.log('Initializing country tabs...');
          
          // Get references to all elements that need to be updated
          const tabs = document.querySelectorAll('.country-tab');
          const mapContainers = document.querySelectorAll('[data-map-country]');
          
          console.log('Tabs found:', tabs.length);
          console.log('Map containers found:', mapContainers.length);
          
          if (tabs.length === 0) {
            console.error('No tabs found');
            return;
          }
          
          // Function to update map visibility
          function updateMapVisibility(countryCode) {
            console.log('Updating map for country:', countryCode);
            
            // First hide all maps
            mapContainers.forEach(container => {
              container.style.display = 'none';
            });
            
            // Then show the selected one
            const selectedMap = document.querySelector(`[data-map-country="${countryCode}"]`);
            if (selectedMap) {
              selectedMap.style.display = 'block';
              console.log('Map shown for:', countryCode);
            } else {
              console.error('No map found for:', countryCode);
            }
          }
          
          // Function to handle tab selection
          function handleTabSelection(tab) {
            // Reset styles for all tabs to yellow background + white text
            tabs.forEach(t => {
              t.classList.remove('bg-orange', 'border', 'border-white');
              t.classList.add('bg-[#FBCC38]', 'text-white');
              t.style.opacity = '0.95';
            });

            // Apply active styles to clicked tab: orange background + white text
            tab.classList.remove('bg-[#FBCC38]');
            tab.classList.add('bg-orange', 'border', 'border-white', 'text-white');
            tab.style.opacity = '1';

            // Update map based on country code
            const countryCode = tab.getAttribute('data-country-code');
            if (countryCode) {
              updateMapVisibility(countryCode);
            }
          }
          
          // Add click event listeners to tabs
          tabs.forEach(tab => {
            tab.addEventListener('click', function(e) {
              e.preventDefault();
              console.log('Tab clicked:', tab.getAttribute('data-country-code'));
              handleTabSelection(tab);
            });
          });
          
          // Initialize with first tab (set active styles and show its map)
          if (tabs.length > 0) {
            handleTabSelection(tabs[0]);
          }
        }
        
        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initializeCountryTabs);
        } else {
          initializeCountryTabs();
        }
        
        // Also try after a short delay as backup
        setTimeout(initializeCountryTabs, 100);
      })();
    </script>
  </div>
</MainLayout>