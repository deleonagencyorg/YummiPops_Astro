---
import { routesConfig, getRouteById } from '../../config/routes';
import { setLocale, t, type Locale } from '../../i18n/i18n';
import MainLayout from '../../layouts/MainLayout.astro';
import HomePageContent from '../../views/Home/index.astro';
import { getPageBySlug } from '../../services/api/pages';

export async function getStaticPaths() {
  const homeRoute = getRouteById('home');
  if (!homeRoute) return [];

  return Object.keys(homeRoute.slugs).map(lang => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Locale };
setLocale(lang);

const homeRoute = getRouteById('home');
if (!homeRoute) {
  throw new Error("Home route configuration is missing.");
}

// Intentar cargar la página 'home' o 'inicio' desde el CMS
const cmsPage = await getPageBySlug('home', lang) || await getPageBySlug('inicio', lang);

const pageTitle = cmsPage?.metaTitle || (homeRoute.metaTitleKey ? t(homeRoute.metaTitleKey) : 'Yummi Pops');
const pageDescription = cmsPage?.metaDescription || (homeRoute.metaDescriptionKey ? t(homeRoute.metaDescriptionKey) : '');
const seoKeywords = cmsPage?.metaKeywords || (lang === 'es' 
  ? 'yummi pops, palomitas, nacho, snacks centroamérica, snacks yummies'
  : 'yummi pops, popcorn, nacho, central america snacks, snacks yummies');

const ogTitle = cmsPage?.ogTitle || pageTitle;
const ogDescription = cmsPage?.ogDescription || pageDescription;
const ogImage = cmsPage?.ogImage || "https://snack.yummiespromociones.com/SnacksyummiesAssets/Yummi-pops-3.webp";

const ContentComponent = HomePageContent;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  keywords={seoKeywords}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  canonicalUrl={`https://yummipops.com/${lang}`}
>
  <ContentComponent />
</MainLayout>
