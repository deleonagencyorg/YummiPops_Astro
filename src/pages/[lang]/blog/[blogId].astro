---
// src/pages/[lang]/blog/[blogId].astro
import { t, setLocale, type Locale } from '../../../i18n/i18n';
import MainLayout from '../../../layouts/MainLayout.astro';
import BlogDetail from '../../../views/Blog/Detail/index.astro';

export function getStaticPaths() {
  const locales = ['en', 'es'];
  const paths = [];

  for (const locale of locales) {
    // Obtener posts para este idioma usando t()
    const posts = t('items', { namespace: 'blog', locale: locale as Locale }) || [];
    
    // Para cada post, crear una ruta
    for (const post of posts) {
      paths.push({
        params: { lang: locale, blogId: post.slug || post.id },
        props: { post, currentLang: locale }
      });
    }
  }

  console.log(`Generadas ${paths.length} rutas de blog`);
  return paths;
}

const { post, currentLang } = Astro.props;
const { lang, blogId } = Astro.params;

// Establecer el idioma para las traducciones
setLocale(lang as Locale);
---

<MainLayout title={post.title}>
  <BlogDetail currentLang={currentLang} postSlug={blogId} />
</MainLayout>