---
// src/pages/[lang]/products/[productId].astro
import { t, setLocale, type Locale } from '../../../i18n/i18n';
import MainLayout from '../../../layouts/MainLayout.astro';
import ProductDetail from '../../../views/Products/Detail/index.astro';
import { getAllProducts } from '../../../services/api/products';

export async function getStaticPaths() {
  const locales = ['en'];
  const paths = [];

  for (const locale of locales) {
    const cmsProducts = await getAllProducts(locale);
    const localProducts = t('items', { namespace: 'products', locale: locale as Locale }) || [];
    
    // Combinar productos sin duplicar
    const productsMap = new Map();
    localProducts.forEach((p: any) => {
      if (p.id) productsMap.set(p.id, p);
      if (p.slug) productsMap.set(p.slug, p);
    });
    cmsProducts.forEach((p: any) => {
      if (p.id) productsMap.set(p.id, p);
      if (p.slug) productsMap.set(p.slug, p);
    });
    
    const allProducts = Array.from(new Set(productsMap.values()));

    for (const product of allProducts) {
      const primaryKey = product.slug || product.id;
      if (primaryKey) {
        paths.push({
          params: { lang: locale, productId: primaryKey },
          props: { product, currentLang: locale }
        });
      }

      if (product.id && product.slug && product.id !== product.slug) {
        paths.push({
          params: { lang: locale, productId: product.id },
          props: { product, currentLang: locale }
        });
      }
    }
  }

  return paths;
}

const { product, currentLang } = Astro.props;
const { lang, productId } = Astro.params;

setLocale(lang as Locale);

const backgroundColor = product.background_color || product.backgroundColor || '#0D75C9';
const headerTextColor = product.header_text_color || product.header_color || product.headerTextColor || '#FFFFFF';

const headerColors = {
  backgroundColor: backgroundColor,
  textColor: headerTextColor
};
---

<MainLayout title={product.name} headerColors={headerColors}>
  <ProductDetail currentLang={currentLang} productId={productId} />
</MainLayout>
