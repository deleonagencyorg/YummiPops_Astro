---
// src/pages/[lang]/[pageSlug].astro
import { routesConfig, findRouteBySlug } from '../../config/routes';
import { setLocale, t, type Locale } from '../../i18n/i18n';
import MainLayout from '../../layouts/MainLayout.astro';
import RecipeDetail from '../../views/Recipes/Detail/index.astro';
import { getPageBySlug } from '../../services/api/pages';

interface PageModule {
  default: any;
}

const pageComponents = await Astro.glob('../../views/*/index.astro');

export async function getStaticPaths() {
  const paths = [];
  for (const route of routesConfig) {
    if (route.id === 'home') continue;

    for (const lang in route.slugs) {
      paths.push({
        params: { lang, pageSlug: route.slugs[lang] },
        props: { routeId: route.id }
      });
    }
  }
  return paths;
}

const { lang, pageSlug } = Astro.params as { lang: Locale; pageSlug: string };
const { routeId } = Astro.props as { routeId: string };

setLocale(lang);

const urlParts = Astro.url.pathname.split('/').filter(Boolean);

let isRecipeDetail = false;
let recipeData = null;
let recipeId = '';
let langCode = '';

if (urlParts.length === 3) {
  langCode = urlParts[0];
  const section = urlParts[1];
  const detailId = urlParts[2];
  
  const isRecipesRoute = 
    (langCode === 'es' && section === 'recetas') || 
    (langCode === 'en' && section === 'recipes');
  
  if (isRecipesRoute) {
    try {
      const allRecipes = t('items', { namespace: 'recipes', locale: langCode as Locale }) || [];
      const recipe = allRecipes.find((r: any) => r.id === detailId);
      
      if (recipe) {
        isRecipeDetail = true;
        recipeData = recipe;
        recipeId = detailId;
      } else {
        return Astro.redirect(`/${langCode}/404`);
      }
    } catch (error) {
      return Astro.redirect(`/${langCode}/404`);
    }
  }
}

let pageTitle = '';
let pageDescription = '';
let seoKeywords: string | undefined;
let ogTitle: string | undefined;
let ogDescription: string | undefined;
let ogImage: string | { url: string } | undefined;
let ContentComponent;

if (!isRecipeDetail) {
  const currentRoute = findRouteBySlug(lang, pageSlug);

  if (!currentRoute) {
    return Astro.redirect(`/${lang}/404`);
  }

  const modules = import.meta.glob('../../views/*/index.astro');
  const targetModulePath = currentRoute.contentComponent.replace('@/', '../../');
  const moduleLoader = modules[targetModulePath];

  if (!moduleLoader) {
    return Astro.redirect(`/${lang}/404`);
  }

  const loadedModule = await moduleLoader();
  const ContentComponentModule = loadedModule as PageModule;
  ContentComponent = ContentComponentModule.default;

  if (!ContentComponent) {
    return Astro.redirect(`/${lang}/404`);
  }

  const cmsPage = await getPageBySlug(pageSlug, lang);

  pageTitle = cmsPage?.metaTitle || (currentRoute.metaTitleKey ? t(currentRoute.metaTitleKey) : 'Page');
  pageDescription = cmsPage?.metaDescription || (currentRoute.metaDescriptionKey ? t(currentRoute.metaDescriptionKey) : '');
  seoKeywords = cmsPage?.metaKeywords;
  ogTitle = cmsPage?.ogTitle || pageTitle;
  ogDescription = cmsPage?.ogDescription || pageDescription;
  ogImage = cmsPage?.ogImage || cmsPage?.featuredImage?.url;
}
---

{isRecipeDetail && (
  <MainLayout
    title={recipeData.title ?? ''}
    description={recipeData.description || ''}
    keywords={recipeData.metaKeywords}
    ogTitle={recipeData.ogTitle || recipeData.title}
    ogDescription={recipeData.ogDescription || recipeData.description}
    ogImage={recipeData.ogImage || recipeData.image}
  >
    <RecipeDetail currentLang={langCode as Locale} recipeId={recipeId} />
  </MainLayout>
)}

{!isRecipeDetail && (
  <MainLayout
    title={pageTitle}
    description={pageDescription}
    keywords={seoKeywords}
    ogTitle={ogTitle}
    ogDescription={ogDescription}
    ogImage={ogImage}
  >
    <ContentComponent />
  </MainLayout>
)}
